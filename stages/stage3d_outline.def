;--------------------------------------------------------
[Info]
name = "Third Heights"
displayname = "Third Heights"
versiondate = 11,25,2023
mugenversion = 1.1
author = "SuperFromND"; modifed by Eiton

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -300
boundright = 300
boundhigh = -50
boundlow = 20

verticalfollow = 0
floortension = 250
tension = 100

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 0
zoomin=1
zoomout=0.75
;Field of view. 30 is good for photorealistic scenes, but feel free to tweak this to your preference.
fov = 30
yshift = -.10
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -240
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 240
p2starty = 0
p2facing = -1

;--- Common ---
leftbound = -4000
rightbound = 4000

;--------------------------------------------------------
[Bound]
screenleft = 75
screenright = 75

;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 1

localcoord = 1280, 720
xscale = 1
yscale = 1

portraitscale = 4

;--------------------------------------------------------
[Shadow]
intensity = 96
color = 0,0,0
yscale = .3
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic =
bgmvolume = 100

;========================================================
[BGdef]

;Filename of 3D model file
;Supported file types are gltf and glb; supported by most modern 3D model programs.
;It is recommended to use PNG/JPEG/embedded image format for textures. Compressed DDS textures are not supported.
;Make sure the world origin of the model is at the camera's starting point.
model = stage3d_outline.glb

;Filename of .sff file, required by spec (and for stage portraits)
spr = stage3d_outline.sff

;debugbg = 0

;-------------------------------------
; Model element definition
[Model]

; X, Y, and Z coordinates of the model
offset = 0,-0.2,-0.9

; Scale of the model
scale = 0.045, 0.045, 0.045

;-------------------------------------
; Stage portrait data
[Begin Action 9000]
9000,1, 0,0,-1
