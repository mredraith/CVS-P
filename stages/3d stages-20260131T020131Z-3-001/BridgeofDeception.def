;--------------------------------------------------------
[Info]
name = "Bridge of Deception"
author = "xcheatdeath"
;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -225
boundright = 225
boundhigh = -425
boundlow = 0

verticalfollow = 1
floortension = 250
tension = 100

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 0

zoomin=1
zoomout=.75

;Field of view. 30 is good for photorealistic scenes, but feel free to tweak this to your preference.
fov = 75
yshift=-.20
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -140
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 140
p2starty = 0
p2facing = -1

;--- Common ---
leftbound  = -4000
rightbound =  4000
;-------------------------------------------------------
[Scaling]
 ;No need to change these values
topz     = 0
botz     = 50      
topscale = 1       
botscale = 1.2     
;--------------------------------------------------------
[Bound]
screenleft = 75
screenright = 75
;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 0

localcoord = 640,480
xscale = 1
yscale = 1

portraitscale = 1
;--------------------------------------------------------
[Scaling]
topz = 0
botz = 50
topscale = 1
botscale = 1.2
;--------------------------------------------------------
[Shadow]
intensity=100
yscale=0.14
fade.range=-100,0
;--------------------------------------------------------
[Reflection]
intensity = 0
;--------------------------------------------------------
[Music]
bgmusic = BridgeofDeception.mp3
bgvolume = 0
;------------------------------------
[BGdef]
model = BridgeofDeception.glb
spr = BridgeofDeception.sff
debugbg = 0

;-------------------------------------
; Model element definition
[Model]
environment = BridgeofDeception.hdr
environmentintensity = 0.5
; X, Y, and Z coordinates of the model
offset = 0,-0.2,-0.47

; Scale of the model
scale = 0.08, 0.08, 0.08
;--------------ANIMS--------------------------
[Begin Action 9000]
9000,1,0,0,-1