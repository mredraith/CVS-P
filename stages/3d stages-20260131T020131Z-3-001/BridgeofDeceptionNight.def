;--------------------------------------------------------
[Info]
name = "Bridge of Deception (Night)"
author = "xcheatdeath"
;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -225
boundright = 225
boundhigh = -425
boundlow = 0

verticalfollow = 1
floortension = 250
tension = 100

overdrawhigh = 120
overdrawlow = 120
cuthigh = 0
cutlow = 0

zoomin=1
zoomout=.75

;Field of view. 30 is good for photorealistic scenes, but feel free to tweak this to your preference.
fov = 75
yshift=-.20
