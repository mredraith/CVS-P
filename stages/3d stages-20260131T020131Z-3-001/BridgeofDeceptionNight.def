;--- Common ---
leftbound  = -4000
rightbound =  4000
;-------------------------------------------------------
[Scaling]
 ;No need to change these values
topz     = 0
botz     = 50      
topscale = 1       
botscale = 1.2     
;--------------------------------------------------------
[Bound]
screenleft = 75
screenright = 75
;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 0

localcoord = 640,480
xscale = 1
yscale = 1

portraitscale = 1
;--------------------------------------------------------
[Scaling]
topz = 0
botz = 50
topscale = 1
botscale = 1.2
;--------------------------------------------------------
[Shadow]
