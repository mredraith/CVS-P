[Info]
name = "Eidolon Wall"
author = "Phantom.of.the.Server"
versiondate = 25.04.2025
ikemenversion = 1.0

[Music]
bgmusic = EidolonWall.mp3
bgmvolume = 100

[Camera]
startx = 0
starty = 0
boundleft = -640
boundright = 640
boundhigh = -720
boundlow = 0
tension = 120
tensionhigh = 240
tensionlow = 0
verticalfollow = 1; Ikemen
overdrawhigh = 0
overdrawlow = 0
cuthigh = 104
cutlow = 16
startzoom = 1
zoomout = 0.80; Samsho
zoomin = 1
fov = 36
yshift = 0

[PlayerInfo]
p1startx = -140
p1starty = 0
p1facing = 1

p2startx = 140
p2starty = 0
p2facing = -1

leftbound = -2000
rightbound = 2000

[Bound]
screenleft = 30
screenright = 30

[StageInfo]
zoffset = 432; not used. Automatic in 3D stages
autoturn = 1
resetBG = 0
localcoord = 640, 480

[Shadow]
intensity = 128
color = 0, 0, 0
yscale = 0.20
fade.range = -480, 0
;xshear = 0.20

[Reflection]
intensity = 0


;=====<MAIN BG DEFINITION>=====
[BGdef]
model = EidolonWall.glb
spr = EidolonWall.sff
debugbg = 0

;[BG Ruler]
;type = normal
;spriteno = 9000, 1
;layerno = 0
;start = 0, 432
;delta = 1, 1


;=====<MODEL DEFINITION>=====
[Model]
offset = 0, -0.26, -1
scale = 0.05, 0.05, 0.05
;environment =
;environmentintensity = 0.25


;=====<ANIMATION>=====
[Begin Action 9000]
9000,1, 0,0, 1
