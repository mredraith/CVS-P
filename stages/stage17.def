[Info]
name = "Space"
displayname = "Space"
author = "MichaHil"

;--------------------------------------------------------
[Camera]
startx = 0
starty = 200
boundleft = -400
boundright = 400
boundhigh = -50
boundlow = 200

verticalfollow = 0
floortension = 250
tension = 100

overdrawhigh = 0
overdrawlow = 240
cuthigh = 0
cutlow = 0
zoomin=1
zoomout=1
;Field of view. 30 is good for photorealistic scenes, but feel free to tweak this to your preference.
fov = 60
yshift = -.10
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -120
p1starty = 0
p1facing = 1

;--- Player 2 ---
p2startx = 120
p2starty = 0
p2facing = -1

;--- Common ---
leftbound  = -4000
rightbound =  4000

;--------------------------------------------------------
[Bound]
screenleft = 75 ; 30
screenright = 75; 30

;--------------------------------------------------------
[StageInfo]
zoffset = 660

autoturn = 1
resetBG = 0

localcoord = 640,480
xscale = 1
yscale = 1

portraitscale = 1

;--------------------------------------------------------
[Shadow]
intensity = 72
color = 0,0,0
yscale = .5
fade.range = 0,0

;--------------------------------------------------------
[Reflection]
intensity = 0
yscale=1
fade.range=-100,0
;--------------------------------------------------------
[Music]
bgmusic =kfm3D.mp3
bgmvolume = 100

;========================================================
[BGdef]

;Filename of 3D model file
;Supported file types are gltf and glb; supported by most modern 3D model programs.
;It is recommended to use PNG/JPEG/embedded image format for textures. Compressed DDS textures are not supported.
;Make sure the world origin of the model is at the camera's starting point.
model = stage17.glb

;Filename of .sff file, required by spec (and for stage portraits)
spr = stage01.sff

;debugbg = 0

;-------------------------------------
; Model element definition
[Model]

; X, Y, and Z coordinates of the model
offset = 0,-0.2,-0.5

; Scale of the model
scale = 0.06, 0.06, 0.06
;-------------------------------------
; Stage portrait data
[Begin Action 9000]
9000,1, 0,0,-1
