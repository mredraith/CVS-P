type    = A
movetype= A
physics = N
juggle  = 4
velset = 1,-8
ctrl = 0
sprpriority = 2

[State 1100, 1]
type = VelAdd
trigger1 = 1
y = .4

[State 1100, 3]
type = HitDef
trigger1 = AnimElem = 8
attr = A, SA
animtype  = Heavy
damage    = 50, 10
priority  = 5
guardflag = MA
pausetime = 12,12
