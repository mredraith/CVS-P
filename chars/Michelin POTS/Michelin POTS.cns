ctrl = 0
anim = 181
velset = 0,0

[State 181, 0]
type = AssertSpecial
triggerall = var(59) = 0
trigger1 = Time < 200
flag = RoundNotOver

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

