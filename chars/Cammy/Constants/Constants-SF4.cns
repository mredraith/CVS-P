[Quotes];(1-18)
victory0 = "You won't get anywhere until you learn a thing or two about fighting."
victory1 = "Did you take me for an amateur? I guess you paid for that mistake."
victory2 = "If all the fights are this easy, I'm going to get bored real quick... "
victory3 = "Your missing teeth will remind you of my victory."
victory4 = "Sorry about that, but I don't have time to indulge you with this fight!"
victory5 = "How does it feel getting beaten up by a pretty little girl like me? "
victory6 = "I didn't even break a sweat."
victory7 = "I've no time to waste teaching amateurs to fight."
victory8 = "How dreadfully dull!"
victory9 = "Nothing personal. It was just a mission."
victory10 = "This is Cammy. Target's neutralized. Moving on to next mission."
victory11 = "You're far too slow to take me on."
victory12 = "You must enjoy being beat. Let me remodel your face one more time!"
victory13 = "You can't escape my sting!"
victory14 = "A rematch? Maybe some other time when I don't have a mission to worry about."
victory15 = "Fighting amateurs like you is a waste of my precious time."
victory16 = "Mission accomplished!"
victory17 = "Off to find my next target!"

