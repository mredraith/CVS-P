victory38 = "Live on the edge of shadow and do not be consumed by it. That's the Hizoku way."
;Yuri
victory39 = "Cherish the bond you share with your share with your brother. It will be too late once you lose him."
victory40 = "Rose's wisdom guided us through the darkest times. Her strength was immense."
victory41 = "The barriers between worlds are fragile. We must guard them."
victory42 = "Forced convergence? No thanks, I like my free will."
victory43 = "This power of potential... it's a dangerous weapon."
victory44 = "Let your spirit dance, even in the face of darkness."
victory45 = "The Echo Forge unleashed more than Bison bargained for."
victory46 = "My Echo was strong, but my will is stronger."
victory47 = "Demons and Echoes... this world has seen too much."
victory48 = "Jedah's ambition threatened all realms. It had to be stopped."
victory49 = "The price for their 'perfection' was too high."
victory50 = "Find your song, and let it drown out the noise of chaos."
victory51 = "CE thought they could play god. They were wrong."
victory52 = "The echoes of their actions will resonate for eternity."
victory53 = "The battle against oneself is often the hardest."
victory54 = "Makai's taint will not spread further!"
victory55 = "Healing is also a form of fighting."
victory56 = "Fractured realities, fractured selves. A messy business."
victory57 = "We fight on, honoring those we lost."
victory58 = "May their sacrifices pave the way for a brighter future."
victory59 = "The world is healing, slowly but surely. We must protect that peace."
victory60 = "Like Elena, I'll find my rhythm and dance through this despair."
victory61 = "These Echoes... they show us what we could be, for better or worse."
victory62 = "Even the smallest act of healing sends ripples of hope."
victory63 = "Maxima's final act saved countless lives. A true hero."
victory64 = "Humanity's 'flaws' are its greatest strengths, something CE never understood."
victory65 = "Did you think your reflection held more power than the original?"
victory66 = "Those grey suits won't be missed."
victory67 = "We decide our reality, not some detached corporation."
victory68 = "Feel the rhythm of the earth? It's a powerful ally."
victory69 = "Their light helped push back the overwhelming darkness."
victory70 = "Their grand design crumbled under the weight of real spirit."
victory71 = "This isn't just a fight; it's a battle for our very existence against the demonic."
victory72 = "Red Echo, Blue Echo... true strength lies in balancing them."
victory73 = "Back to the abyss with you, creature!"
victory74 = "Some souls shine so brightly they illuminate all realities."
victory75 = "True harmony often comes at a great cost."
victory76 = "My path is my own, not some faded copy."
victory77 = "Even the Darkstalkers had to choose a side when Makai truly rose."
victory78 = "The Demon Lords have fallen. Earth is safe from that particular nightmare."
victory79 = "Morrigan carries a heavy burden, but also a profound connection thanks to her sister."
victory80 = "My heart beats in time with a world that refuses to die."
victory81 = "The beat of life is strong. It will overcome the discord."
victory82 = "The hunger of Makai is terrifying. We cannot let it win."
victory83 = "A universe without chaos is a universe without growth."
victory84 = "Harmony will be restored, one step, one victory at a time."
victory85 = "Convergence Enterprises... your sterile order is an affront to life."
victory86 = "The Final Judge was a monument to failed logic."
victory87 = "Sacrifice is sometimes the highest form of strength."
victory88 = "Some Echoes are warnings, others are inspirations."
victory89 = "My power is more than a match for your fiendish tricks."
victory90 = "Lilith's sacrifice... a light that will never fade."
victory91 = "Your techniques are flawed."
victory92 = "You lack discipline."
victory93 = "This power flows through me!"
victory94 = "Victory is mine!"
victory95 = "Every victory is a lesson learned."
victory96 = "Feel the sting of defeat. It will make you stronger... or break you."
victory97 = "In this clash of worlds, I stand supreme."
victory98 = "This win was well-earned."
victory99 = "Is that all you've got?"

; ---------------------------------------------------------------------------
; Universal Feint System v3 (Added by Patcher)
; Cancels any move on its first contact frame if HP has been held for 10+ frames.
; This system uses Var(59) to track the hold duration.
[StateDef -2]

; State -2: Increment Hold Timer
; -- If HP ('z') is held, count up.
[State -2, Feint Hold Timer Increment]
type = VarSet
v = 59
triggerall = alive
trigger1 = command = "z"
value = Var(59) + 1
ignorehitpause = 1

; State -2: Reset Hold Timer
; -- If HP ('z') is NOT held, reset the counter to 0.
[State -2, Feint Hold Timer Reset]
type = VarSet
v = 59
triggerall = alive
trigger1 = command != "z"
value = 0
ignorehitpause = 1

; State -2: Feint Cancel Activation
; -- Change state back to idle if the feint conditions are met.
[State -2, Feint Cancel Activation]
type = ChangeState
value = 0
triggerall = alive && ctrl
trigger1 = MoveContact = 1
trigger2 = Var(59) > 10
trigger3 = Power >= 100

; State -2: Feint Cancel Power Cost
; -- Subtract the power cost. Triggers must match activation exactly.
[State -2, Feint Cancel Power Cost]
type = PowerAdd
value = -100
triggerall = alive && ctrl
trigger1 = MoveContact = 1
trigger2 = Var(59) > 10
trigger3 = Power >= 100
; --- End Universal Feint System ---