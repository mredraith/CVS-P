;---------------------------------------------------------------------------
;Shaki Juuryuu 
[StateDef 1000]
type=S
movetype=A
physics=N
ctrl=0
velset=0,0
poweradd=Ifelse(var(55), 0 , 72 * !var(20))
sprpriority=1
facep2=1

[State 1000, Helper]
type = Helper
trigger1 = Time = 7 && var(55)
helpertype = normal
name = "Ankei Shaki Juuryuu1"
ID = 101000
stateno = 101000
pos = 0,0
postype = p1
ownpal = 1

[State 1000, Helper]
type = Helper
trigger1 = time = 14 && var(55)
helpertype = normal
name = "Ankei Shaki Juuryuu2"
ID = 101000
stateno = 101000
pos = 0,0
postype = p1
ownpal = 1

[State 1000, VarSet]
type=VarSet
trigger1 =!AILevel && !time
var(10)=Ifelse(command="Shaki Juuryuu1",0,Ifelse(command="Shaki Juuryuu2",1,2))
ignorehitpause=1

[State 1000, VarSet]
type=VarSet
trigger1 =AILevel&& !time
var(10)=ifelse(random<700,1,2)
ignorehitpause=1

[State 1000, Anim]
type = ChangeAnim
trigger1 = !time
value = 1000+var(10)
ignorehitpause=1

[State 1000, Swing Snd]
type=PlaySnd
trigger1=AnimElem=2
value=1,2
channel=4
[State 1000, Voice]
type=PlaySnd
trigger1=AnimElem=2
value=1000,0
channel=1

[State 1000, Width]
type = Width
trigger1 = 1
edge = 35,0

[State 1000, VelSet]
type = VelSet
trigger1 = AnimElem = 3
x = 6 + (var(10)*0.5)

[State 1000, VelMul]
type = VelMul
trigger1 = AnimElemTime(3) > 0
x = .65

[State 1000, VelSet]
type = VelSet
trigger1 = AnimElem = 8
x = 0

[State 1000, Hit]
type = HitDef
trigger1=!Time
damage=58+3*var(10), 8
attr=S, SA
animtype=Hard
priority = 6, Hit
getpower=Ifelse(var(55), 0 , 72 * !var(20)), 0
hitflag = MAF
guardflag = M
pausetime=ifElse(var(20), 12, 11), ifElse(var(20), 13, 12)
sparkNo=-1 + 0 * (var(33) := 8013)
guard.sparkNo=-1 + 0 * (var(34) := 8000)
sparkXY=-10 + 0 * (var(35) := 70), var(36) := -70
hitsound=S2+10*var(44), 5
guardsound=s130, 0
ground.type=low
ground.slidetime=17
ground.hittime =17 
guard.hittime = (17) - 6
ground.velocity=ifelse(var(55) > 0,0,-9)
guard.velocity=ifelse(var(55) > 0,0,-9)
air.velocity=ifelse(var(55) > 0,0,-5.5),ifelse(var(55) > 0,0,-7)
ground.cornerpush.veloff = ifelse(var(55 > 0),0, 9)
air.cornerpush.veloff = 0
guard.cornerpush.veloff = ifelse(var(55 > 0),0, 9)
fall = 0
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd=-255,-255,-255,48
envshake.time=12
envshake.ampl=4
envShake.freq=120
persistent=0

[State 1000, StateTypeSet: Idle]
type=StateTypeSet
trigger1=AnimElemTime(5)= 0
moveType=I

[State 1000, ChangeState]
type = ChangeState
trigger1 = !animtime
value = 0
ctrl = 1

[State 1000, ChangeState]
type = ChangeState
trigger1 = AnimElemTime(5)>=1 && var(12)>0
triggerall = AILevel<1
value = IfElse(var(12)=4,1015,1005)

[State 1000, ChangeState]
type = ChangeState
trigger1 = AnimElem = 5 && MoveContact
triggerall = AILevel
value = IfElse(random>500,1015,1005)

[State 1000, ChangeState]
type = ChangeState
trigger1 = AnimElemTime(4)>=1
trigger1 = AnimElemTime(6)<=0
trigger1 = command = "Shaki Juuryuu1" || command = "Shaki Juuryuu2" || command = "Shaki Juuryuu3" 
value = 1005

[State 1000, ChangeState]
type = ChangeState
trigger1 = movecontact
trigger1 = AnimElemTime(4)>=1
trigger1 = AnimElemTime(6)<=0
trigger1 = command = "holdfwd" && (command = "a" || command = "b") 
value = 1015

