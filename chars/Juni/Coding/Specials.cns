[Statedef 1000]
type=S
physics=N
movetype=A
anim=1000
ctrl=0
velset=0,0
sprpriority=1
poweradd=72*!var(20)
facep2=1

[State 1000, Button]
type=varset
trigger1= !time && !AILevel
var(10)= ifelse((command="c" || command="rlsc"), 2, ifelse((command="b" || command="rlsb"), 1, 0))
[State 1000, Button AI]
