attr = S,SA
hitflag = MAF
guardflag = M
priority = 4, Hit
damage = ceil(ifelse(fvar(11)*ifelse(var(10)=1, 90, 83)<7, 7, fvar(11)*ifelse(var(10)=1, 90, 83))), 11
