type = null;VelSet
trigger1 = Vel Y>0 && Pos Y>=0 && Anim=28000 && time<60
x = ifelse(Vel X >0,1.0,-1.5)
y = -3.0

[State 18000]
type = ChangeAnim
trigger1 = Anim=28000 && Vel Y>0 && Pos Y >=0
value=29000

[State 180000, StatetypeSet]
type = StatetypeSet
trigger1 = Anim=29000
Statetype = S
physics = S

[State 180000, VelSet]
type = VelSet
trigger1 = Anim=29000
x = 0
y = 0

[State 180000, PosSet]
type = PosSet
trigger1 = Anim=29000
y = 0

[State 18000,Turn]
type = Turn
trigger1 = Root,Facing=1 && Time=0

[State 18000]
type = parentvarSet
trigger1 = Anim=29000 && (Pos X!=[-2,2])
var(54)=ceil(Pos X)

[State 18000]
type = parentvarSet
triggerall = Anim!=28000
trigger1 = (RootDist X=[5,40]) && Root,Statetype!=A
trigger1 = (root,movetype=I && root,StateNo<40) || (root,StateNo=[100,110])
var(54)=0

[State 18000,PlaySnd]
type = PlaySnd
trigger1 = root,var(54)=0
value = 100,1

[State 20000]
type = DestroySelf
trigger1 = root,var(54)=0

[State 18000]
type = null;ChangeState
triggerall = Anim!=28000
trigger1 = (RootDist X=[5,40]) && Root,Statetype!=A
trigger1 = (root,movetype=I && root,StateNo<40)
value = 20000

