;---------------------------------------------------------------------------
; Cross Diving (Start)
[Statedef 1100]
type    = S
movetype= A
physics = S
poweradd=72*!var(20)
ctrl = 0
velset = 0,0
anim = 1100
sprpriority = 2

[State 1000, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))

[State 1000, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || Random < 500), 2, ifElse(Random < 500, 1, 0))

[State 200, 1]
type = PlaySnd
trigger1 = !time
value = 1100,0
channel = 0

[State 102, Dust]
type = helper
trigger1=!animtime
stateno = 8103
ID = 8100
name = "Dash Dust"
pos = -20,10
postype = p1
pausemovetime = 255
supermovetime = 255
ownpal = 1

[State 1100, 3]
type = ChangeState
trigger1 = Animtime = 0
value = 1101

;---------------------------------------------------------------------------
; Cross Diving (Hit)
[Statedef 1101]
type = A
movetype = A
physics = N
anim = Ifelse(var(10),1102,1101)
poweradd = 0
velset = 0
ctrl = 0

[State 1101, width]
type = width
trigger1 = 1
edge = 10,0

[State 1101, pos]
type = Velset
trigger1 = 1
x = 6+1.5*var(10)

[State 1101, pos]
type = Velset
trigger1 = time < 2
y = -1-.5*var(10)

[State 1101, pos]
type = Veladd
trigger1 = time > 1
y = .3

[State 1101, Swing Snd]
type=Playsnd
trigger1= !time
value=1,13
channel=1

[State 1101, 2]
type = HitDef
trigger1 = !var(16) && (var(15)<1 || var(20))
trigger1 = !time
attr = A, SA
damage = ceil(ifElse(fvar(10) * 90+6 < 7, 7, fvar(10) * 90+6)), 7
getpower=36* !var(20), 0
givepower=35,35
animtype = hard
hitflag = MAF
guardflag = MA
sparkNo=-1 + 0 * (var(33) := 8013)
guard.sparkNo=-1 + 0 * (var(34) := 8001)
sparkXY=-10 + 0 * (var(35) := 85), var(36) := -70
hitsound=S2+10*var(44),2
guardsound=s130, 0
pausetime = 10,12
ground.hittime = 17
guard.hittime = (17) - 6
ground.type = low
ground.slidetime = 17
ground.velocity = -3,-6
air.velocity = -3,-6
fall = 1
fall.recover = 1
fall.recovertime = 120
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd=-255,-255,-255,48
envshake.time=12
envshake.ampl=3
envShake.freq=120
yAccel = (0.5 + (ComboCount * 0.06))
id = 1100

[State 1101, 3]
type = ChangeState
trigger1 = !Animtime
value = 1105

