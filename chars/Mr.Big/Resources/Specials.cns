trigger1 = !time
var(10)=3
ignorehitpause=1

[State 1000, Voice]
type=PlaySnd
trigger1 =!time
value=1000,0
channel=0
[State 1000, Move Snd]
type=PlaySnd
trigger1=AnimElem=7
value=1001,0
channel=4

[State 102, Dust]
type = helper
trigger1=AnimElem=6
stateno = 8103
ID = 8100
name = "Dash Dust"
pos = -20,10
postype = p1
pausemovetime = 255
supermovetime = 255
ownpal = 1

[State 1000, Helper]
type = helper
trigger1 = animelem=7
helpertype = normal
stateno = 1055
ID = 1005
name = "Ground Blaster Helper"
postype = p1
pos=-30,0
size.xscale = 0.5
size.yscale = 0.5
