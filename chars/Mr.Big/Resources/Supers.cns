;------------------------------------------------------------------
; Blaster Wave
[Statedef 3000]
type=S
movetype=A
physics=N
anim = 3000
poweradd=-1000
ctrl=0
velset=0,0
sprpriority=3
facep2=1

[State 3000, No Corner Push]
type=VarSet
trigger1=time=3
fvar(5)=0
[State 3000, Unguardable]
type=VarSet
trigger1=time=3 && NumEnemy
trigger1=(EnemyNear, StateNo !=[120,155])
var(17)=45
[State 3000, Super Cancel Flag]
type=VarSet
trigger1=!Time
var(21)=(PrevStateNo=[1000,2999]) && var(6)
[State 3000, Hyper Cancel Flag]
type=VarSet
trigger1=!Time
var(22)=((prevstateno=[3000,4999]) && var(7)) || var(20)
[State 3000, Super Cancel Flash]
type=PalFX
trigger1=var(21) || var(22)
trigger1=!(Time % 2) && Time <=12
time=1
add=255,255,255
ignoreHitPause=1
[State 3000, Super Cancel Juggle Reset]
type=VarSet
trigger1=!Time
trigger1=var(21) || var(22)
var(15)=0
ignoreHitPause=1

[State 3000, SuperPause FX]
type=Helper
trigger1=time=3
helperType=Normal
stateNo=8500
ID=8500
name="Superpause FX"
posType=P1
pos=8,-106
superMoveTime=255
size.xScale=1
size.yScale=1
ownPal=1
[State 3000, SuperPause]
type=SuperPause
trigger1=time=3
time=45
moveTime=45
p2DefMul=1
unHittable=1
anim=-1
sound=s8500,0
darken=0
poweradd=0

[State 3000, NotHitBy]
type = NotHitBy
trigger1 = AnimElemTime(14) < 0 
value = SCA
time = 1

[State 3000, 6]
type = screenbound	
trigger1 = time >=0
value = 0
movecamera = 1,0

[State 3000, Voice]
type = PlaySnd
trigger1 = AnimElemtime(3) = 20
value = 3000,0
channel = 0

[State 3000, Swing Snd]
type = PlaySnd
trigger1 = AnimElem = 5 || AnimElem = 6 || AnimElem = 7 || AnimElem = 8 || AnimElem = 9
value = 3001,0
channel = 1

[State 3000, StopSnd]
type = StopSnd
trigger1 = animelem = 10
channel = 1

[State 3000, Projectile]
type = Helper
trigger1 = AnimElem = 6
helperType = Normal
stateNo = 3005
ID = 3005
name = "Raikoken Projectile"
posType = P1
pos = 88, -70
size.xScale = 0.5
size.yScale = 0.5
ownPal = 1

[State 3000, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

