; Quem_sou_eu [Var(39)]: 0-Morto, 1-Primeiro, 2-Segundo
; Colaboração [Var(38)]: 1-Lutar só, 2-Duplo Especial, 3-Um Ataque, 4-Counter
; Vez na luta [Var(37)]: 1-Primeiro, 2-Segundo
; Verificação [Var(36)]: Meu ID
; [Var(35)]: 0-Proíbe sair de tela, 1-Permite sair de tela
; P3 life [Var(34)]: Memoriza a vida
; Recuperação [Var(33)]: Memoriza a vida


;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, 1] ; debug
type = DisplayToClipboard
trigger1 = roundstate > 0
;text="eu39 %d, vez37 %d, Colab38 %d, sair? %d";bake %d";
;params = Var(39), var(37),var(38),Var(35);floor(backedgedist);
;text = "Var(9) %d, Var(11) %d, var(12) %d, var(17) %d"
;params= Var(9), Var(11), var(12), var(17);floor(var(11)/10**(var(12)+1))
;text="39=37? %d, Colab %d, p3life %d, sair? %d";bake %d";
;params = (Var(39)=Var(37)), var(38),var(34),Var(35);floor(backedgedist);
;text="p2bodydist x %d, p2bodydist y %d, var(17) %d, var(20) %d"
;params = floor(p2bodydist x), floor(p2bodydist y), (var(17)),var(20)
text = "p1 X %d, p2 x %d, var(12) %d, var(17) %d"
params= ceil(screenpos x), ceil((enemy,screenpos x)), var(12), var(17);floor(var(11)/10**(var(12)+1))

;---------------------------------------------------------------------------
[State -2, pressstart]; - próprio
type = Explod
triggerall = var(20) != 0 && roundstate < 3 && var(17)<10
trigger1 = (gametime%60)= id && life != 0
id = 8620
anim = 8620
pos = ((enemy, id)<id)*160, (id - 32)*2
postype = Left
removetime = 30;-2
bindtime = -1
sprpriority = -1
ownpal = 1
ontop = 1
scale = 0.5,0.5
;---------------------------------------------------------------------------
[State -2, pressstart]; - mvsc2 screen pack
type = Explod
triggerall = var(20) != 0 && roundstate < 3 && var(17)>=10
trigger1 = (gametime%60)= id && life != 0
id = 8620
anim = f220
pos = ((enemy, id)<id)*160, (id - 32)*2
postype = Left
removetime = 30;-2
bindtime = -1
sprpriority = -1
ownpal = 1
ontop = 1

[State -2, acertou a parede - som]
type = playsnd
triggerall = numtarget!=0
trigger1 = target, statetype = A && target, movetype= H;
trigger1 = target, backedgedist < 2
trigger1 = target, anim= 5030 || target, anim= 5035
trigger1 = numexplod(8250)=0
trigger1 = target, vel x < 0;movehit && 
persistent = 0;1
value = f7+(var(17)>=10),(target,vel x > 7)+(target,vel y > 7)
volume=255
ignorehitpause = 1

[State -2, acertou a parede]
type = Explod
triggerall = numtarget!=0
trigger1 = target, statetype = A && target, movetype= H;
trigger1 = target, backedgedist < 2
trigger1 = target, anim= 5030 || target, anim= 5035
trigger1 = numexplod(8250)=0
trigger1 = target, vel x < 0;movehit && 
id = 8250
anim = f70;8250
pos = -(target,const(size.air.back)),(target,const(size.mid.pos.y))
postype = P2
removetime = -2
bindtime = 1
;sprpriority = 1
ownpal = 1
ontop = 1
persistent = 0
ignorehitpause=1

[State -2, acertou a parede]; - freio]
type = targetvelset
triggerall = numtarget!=0
trigger1 = numexplod(8250)!=0
trigger1 = target, vel x < 0
x=0

[State -2]
type = Varset
trigger1 = var(9)=1000
var(7) = power

[State -2]
type = Varadd
triggerall = stateno!=4500
trigger1 = var(9)>0
v=9
value = -2

[State -2]
type = Varset
trigger1 = life = 0 || roundstate!=2
trigger2 = stateno= 3000 || stateno= 4000 || stateno= 3500
var(9) = 0

[State -2]
type = powerset
triggerall = stateno!=4500
trigger1 = var(9)>0
value = floor(var(7))

[State -2]
type = removeexplod
trigger1 = var(9)>=0 && numexplod(8520)=1
id = 8520

[State -2]
type = removeexplod
trigger1 = var(9)>=0 && numexplod(8521)=1
id = 8521

[State -2]; com MvsC2 SP
type = explod
trigger1 = var(9)>0 && var(17)>=10
pos = 36+141*(id>(enemy, id)),227
postype = left 
bindtime = -1
sprpriority = 1
