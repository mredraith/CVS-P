value = 8852 

[State 8851, 1] 
type = VarSet 
trigger1 = Time = 0 
sysvar(1) = 0 

[State 8851, VelAdd1] 
type = VelSet 
trigger1 = (var(10) = 1 && command = "holdfwd" && command != "holdback") 
x = 4 

[State 8851, VelAdd2] 
type = VelSet 
trigger1 = (var(10) = 1 && vel X > 0 && command = "holdback") 
x = 2.3 

[State 8851, VelAdd3] 
type = VelSet 
trigger1 = (var(10) = 1 && vel X <= 0 && command = "holdback") 
x = -1 

[State 8851, 3] 
type = ChangeAnim 
triggerall = anim = 41 || anim = 42 || anim = 43 
trigger1 = (Vel y > -2) && (SelfAnimExist(anim + 3)) 
persistent = 0 
value = Anim + 3 

