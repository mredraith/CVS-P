;var(1) =Agarrar no combo
;var(2) =Magia fraca, mdia ou forte.
;var(3) =Air Combo
;var(4) =hit Counter / Pantonerre: quantidade de hits do hiper
;var(5) =Nmero de helpers / projteis do adversrio
;var(6) =Nmero de helpers / projteis ameaadores
;var(7) =Congela power bar no Especial infinito
;var(8) =Plasma Combo (extenso)
;var(9) =Power Up: Durao (1000)
;var(10)=Super pulo: deslocamento horizontal
;var(13)=Fora do combo
;var(14)=Contador do Advanced-Guard
;var(17)=Estou em DOS (par) ou WinMugen? (mpar) - nmero do screen pack
;var(18)=Danger - para o contador de hit
;var(19)=Score
;var(20)=AI
;var(38)=TAG-TEAM:ajuda
;
; POISON's constants and state file.

