;--[Starting S-Jump Efects...] --

[State 8850, 3] 
type = MakeDust 
trigger1 = Vel Y < -10 && gametime % 3
pos = 10-ceil(random/50),-2 
spacing = 1 

[State 8850, sound1] 
type=PlaySnd 
trigger1 = time=0;1
value = 8800,0
persistent = 0 
channel = 1 

[State 8850, sound1] 
