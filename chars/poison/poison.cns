trigger1 = time=0 && var(17)>=10
value = F8800,0
persistent = 0 
channel = 1 

;--[Finishing S-Jump Efects...] --

[State 8850, 1] 
type = VarSet 
trigger1 = Time = 0 
sysvar(1) = 0 

[State 8850, VelAdd] 
type = VelSet 
triggerall = var(10) = 1
trigger1 = (var(20) = 0) && (command = "holdfwd") && (command != "holdback") 
trigger2 = var(20) = 1 && P2bodydist x > 10 && abs(P2bodydist y)<abs(Const(size.head.pos.y))
trigger3 = p2bodydist X > 50 && var(20)=1 && (enemynear, pos y < 0)
x = 4 

[State 8850, 2] 
type = ChangeAnim 
trigger1 = Time = 0 
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43)) 

[State 8850, 3] 
type = ChangeState 
trigger1 = AnimTime = 0 
trigger2 = (Vel y > -2) && (SelfAnimExist(anim + 3))
value = 8851 

