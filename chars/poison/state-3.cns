;
;contador de projéteis ou helpers inimigos
;
[State -3]
type = Varset
trigger1 = roundstate = 1
v = 5
value = 0

[State -3]
type = Varset
trigger1 = roundstate = 1 && var(5)=0
v = 5
value = (enemy, numhelper)

[State -3]
type = Varset
trigger1 = 1
v = 6
value = (enemy, numproj) + ((enemy, numhelper) - var(5)*(var(5)!=0))