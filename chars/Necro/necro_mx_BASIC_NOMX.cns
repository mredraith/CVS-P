;PAUSE STAGE
[StateDef 10001]
Type = S
Ctrl = 0
Anim = 99

[State 3000]
Type = Pause
Trigger1 = RoundState = 2
Persistent = 2
Time = 1
MoveTime = 1

[State 3000]
Type = ChangeState
Trigger1 = Parent,Alive && RoundState = 2
;Trigger1 = Command = "start" && Parent,Command = "start"
Value = 10002

[StateDef 10002]
Type = S
Ctrl = 0

[State 3001]
Type = PlaySnd
Trigger1 = Time = 0
Value = 0, 17

[State 3001]
Type = AssertSpecial
Trigger1 = 1
Flag = NoFG

[State 3001]
Type = BGPalFX
Trigger1 = 1
Time = 10
Mul = 100,100,100
Add = 70, 70, 70

[State 3001]
Type = Pause
Trigger1 = 1
Time = 10
MoveTime = 10

[State 3001]
Type = ChangeState
Trigger1 = Time >= 6 ;&& Command = "start"
trigger1 = command = "a" || command = "b" || command = "c" || command = "x" || command = "y" || command = "z"
Value = 10003

[StateDef 10003]
Type = S
Ctrl = 0

[State 3002]
Type = Pause
Trigger1 = Time = 0
Time = 0

[State 3002]
Type = BGPalFX
Trigger1 = Time = 0
Time = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = time>=0
trigger1 = command = "a" || command = "b" || command = "c" || command = "x" || command = "y" || command = "z"
;Trigger1 = Command = "start"

[State -3, RemoveExplod]
type = RemoveExplod
trigger1 = Numhelper(10001) = 0
;trigger2 = parent, Command = "start"
trigger2 = command = "a" || command = "b" || command = "c" || command = "x" || command = "y" || command = "z"
id = 10001

[State 3002]
Type = ChangeState
Trigger1 = Time = 1
Value = 10001

