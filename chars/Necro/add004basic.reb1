trigger1 = var(23) := stateno
trigger2 = NumHelper(3005)
trigger2 = (Helper(3005), StateNo = [3005,3007]) && Helper(3005), var(18)
trigger2 = var(23) := 3000
trigger3 = NumHelper(3055)
trigger3 = (Helper(3055), StateNo = [3007,3056]) && Helper(3055), var(18)
trigger3 = var(23) := 2000
trigger4 = StateNo = 2000
trigger4 = var(23) := 2000
trigger5 = StateNo = 2100
trigger5 = var(23) := 2100
trigger6 = StateNo = 3000 && movecontact
trigger6 = var(23) := 3000
helpertype = normal
stateno = 8600
ID = 8600
name = "Super Finish"
postype = left
pos = 160, -120
ownpal = 1
pausemovetime = 255
supermovetime = 255
ignorehitpause = 1

[State -3, Landing Sound]			;This controller plays a sound everytime KFM lands from a jump, or from his back-dash.
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 			;Jump land
