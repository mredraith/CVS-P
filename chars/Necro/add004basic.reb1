pausemovetime = 0			;if ATTACK STAR, then = 1
removetime = -2
ignorehitpause = 1			;if ATTACK STAR, then = 1
scale = 1, 0.8
ownpal = 1


[State 5100, 9]
type = HitFallDamage
trigger1 = Time = 3

[State 5100, 10]
