;=========================================================================
;Dampener
;=========================================================================
[State -2, Damage based on hits]
type=varset
triggerall= numenemy
trigger1= MoveHit = 1
trigger1=!moveguarded
trigger2=enemynear,movetype=H||enemynear,Statetype=L
trigger2=enemynear,stateno!=5120
fvar(12)=1
ignorehitpause=1
[State -2, Reset var when the opponent recovers]
type=varset
triggerall=numenemy
trigger1=enemynear,hitover && enemynear,hitshakeover && enemynear,ctrl=1
trigger1=enemynear,movetype!=H || enemynear,Statetype!=L || (enemynear,stateno!=[5000,5120])
trigger2= moveguarded
trigger3=(stateno=[810,860]) && movetype!=H
trigger4=enemynear,movetype!=H
fvar(12)=0
ignorehitpause=1

[State -2, Control]
type = Varset
trigger1 = (ctrl||stateno=[0,110])&&fvar(12)
fvar(9) = 1
ignoreHitPause =1
[State -2, Control]
type = Varset
trigger1 = fvar(12)=0
fvar(9) = 0
ignoreHitPause =1

[State -2, combo]
type=varset
trigger1 = (stateno = [200,4999])&& movehit 
fvar(13)=Ifelse(fvar(12)=0,0,Ifelse((stateno = [200,999]),1,Ifelse((stateno = [1000,2999]),2,3)))
ignorehitpause=1

[State -2, Dampener - Normals]
type=varset
trigger1 = (stateno = [200,599]) && fvar(12) && (fvar(13)=[0,1])
fvar(10)= 0.7 * (Ifelse(var(13)<3,1.0,(1.00-(var(13)*.0125))))
ignorehitpause=1
[State -2, Dampener - Normals]
type=varset
trigger1 = (stateno = [600,999]) && fvar(12) && (fvar(13)=[0,1])
fvar(10)= 0.65 * (Ifelse(var(13)<3,1.0,(1.00-(var(13)*.025))))
ignorehitpause=1
[State -2, Dampener - Specials]
type=varset
trigger1 = (stateno = [1000,2999]) && fvar(12) && (fvar(13)=[0,2])
fvar(10)= Ifelse((prevstateno=[3000,4999]),0.3,Ifelse((prevstateno=[200,999])||fvar(10)!=1,0.45,1.0)) * (Ifelse(var(13)<8,1.0,(1.00-(var(13)*.025))))
ignorehitpause=1
[State -2, Dampener for Supers]
type = VarSet
trigger1 = (StateNo = [3000,4999])
fvar(10) = Ifelse(var(22),Ifelse(fvar(20)>1,.6,.4)*Ifelse(var(21),.5,1),Ifelse(var(21)>1,0.55,Ifelse(var(21),.6, 1.0)));* (Ifelse(var(13)<35,1.0,(1.00-(var(13)*.025))))
ignoreHitPause = 1

[State -2, Dampener - Custom Combo]
type=varset
trigger1= var(20)
fvar(10)= .72 * (10 - ifelse(var(13)>=12, 10, var(13))) / 10.0
ignorehitpause=1

[State -2, Dampener - Custom Combo Limiter]
type = varset
triggerall = var(20)
trigger1 = StateNo = [220,229]
trigger2 = StateNo = [250,259]
trigger3 = StateNo = [420,429]
fvar(10) = ifElse(var(13), fvar(10)/1.5, 0.72)
ignorehitpause = 1

[State -2, Dampener - Backup reset]
type=varset
trigger1=fvar(12)=0||var(20)
fvar(11)=0
ignorehitpause=1
[State -2, Backup Dampener]
type=varset
trigger1=fvar(9) && fvar(10)=1 && fvar(12) 
fvar(11)=1
ignorehitpause=1
[State -2, Backup Dampener - supers]
type=varset
trigger1 = 0;fvar(11)
fvar(10)=0.6 * (Ifelse(var(13)<20,1.0,(1.00-(var(13)*.025))))
ignorehitpause=1

[State -2, Dampener for Safety]
type=varset
triggerall = numenemy
trigger1=fvar(9) && fvar(12)
trigger1=(enemynear,Statetype=L||(enemynear,stateno=[5100,5120]))
fvar(10)= Ifelse(fvar(10)>=0.7,0.7,0.6) * (Ifelse(var(13)<25,1.0,(1.00-(var(13)*.025))))
ignorehitpause=1

[State -2, Dampener Reset]
type = VarSet
trigger1 = fvar(12)=0
fvar(10) = 1
ignoreHitPause = 1
[State -2, Dampener Limit]
type=varset
trigger1= fvar(10)<=0.085
fvar(10)=0.085
ignorehitpause=1
[State -2, Dampener itself]
type=attackmulset
trigger1= 1
value=fvar(10)
ignorehitpause=1

;=========================================================================
;Victory Quotes
;=========================================================================
[State -2, Victory Quotes(non-specific)]
type=VictoryQuote
trigger1=1
value=random%8
[State -2, Victory Quote vs. Donald / Ronald]
type=VictoryQuote
triggerall = NumEnemy
trigger1=Enemy, Name="Donald" || Enemy, Name="Ronald" || Enemy, Name="Donald McDonald" || Enemy, Name="Ronald McDonald"
value=8
[State -2, Victory Quote vs. Colonel Sanders]
type=VictoryQuote
triggerall = NumEnemy
trigger1=Enemy, Name="Colonel" && Enemy, AuthorName="peg"
trigger2=Enemy, Name="Colonel Sanders"
value=9
[State -2, Victory Quote vs. Miku Hatsune]
type=VictoryQuote
triggerall = NumEnemy
trigger1=Enemy, Name="HATSUNE MIKU" || Enemy, Name="Miku Hatsune"
value=10

