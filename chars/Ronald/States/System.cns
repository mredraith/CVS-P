trigger1 = !Time && (PrevStateNo != [600,699]) && PrevStateNo != 850
trigger2 = Time = 1 && Anim != 57
trigger3 = Time = 3 && Anim = 57
value = 1

[State 52, Guard: High to Low]
type = StateTypeSet
triggerall = var(20) <= 0
triggerall = ctrl && InGuardDist
trigger1 = !AILevel && ifelse(p2dist x < 0, command = "holdfwd", command = "holdback") && command = "holddown"
statetype = C
