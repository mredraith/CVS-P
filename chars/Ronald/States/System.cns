;Super Jump
[Statedef 123]
type = S
physics = S
moveType = I
anim = 40
ctrl = 0
velSet = 0,0
sprPriority = 1
faceP2 = 1

[State 123, ChangeState]
type = ChangeState
trigger1 = 1
value = 40

[State 123, Reset]
type = varset
trigger1 = !time
sysvar(1) = 0

[State 123, Direction]
type = varset
trigger1 = !AIlevel
sysvar(1) = ifelse(command = "holdfwd", 1, ifelse(command = "holdback", -1, sysvar(1)))
[State 123, Direction]
type = varset
trigger1 = AILevel
sysvar(1) = Ifelse((enemynear, movetype != A || backedgebodydist <= 10), 1, Ifelse((enemynear, movetype = A), -1, 0))

[State 123, High Jump]
type = varset
trigger1 = !time
var(3) = 3

[State 123, Jump Sound]
type = PlaySnd
