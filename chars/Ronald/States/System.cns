;===========<POWER CHARGE>==================
;Power Charge
[StateDef 730]
type = S
physics = S
moveType = I
anim = 730
velSet = 0,0
ctrl = 0

[State 730, PowerAdd]
type = PowerAdd
trigger1 = 1
value = 5 + ifElse(time < 60, 0, (time - 60) / 12)

[State 730, Voice]
type = PlaySnd
trigger1 = Time = 8
value = 731,0
channel = 0

[State 730, Character Flash Level 0]
type = PalFX
trigger1 = Power < 1000
time = 1
add = ceil((33-33*(Power/1000.0))+(sin(Time/6.0*pi)*(33-33*(Power/1000.0)))), ceil((33-8*(Power/1000.0))+(sin(Time/6.0*pi)*(33-8*(Power/1000.0)))), ceil((33+42*(Power/1000.0))+(sin(Time/6.0*pi)*(33+42*(Power/1000.0))))

[State 730, Character Flash Level 1]
type = PalFX
trigger1 = Power >= 1000 && Power < 2000
time = 1
add = ceil((0+50*((Power-1000)/1000.0))+(sin(Time/6.0*pi)*(0+50*((Power-1000)/1000.0)))), ceil((25-25*((Power-1000)/1000.0))+(sin(Time/6.0*pi)*(25-25*((Power-1000)/1000.0)))), ceil((75-25*((Power-1000)/1000.0))+(sin(Time/6.0*pi)*(75-25*((Power-1000)/1000.0))))

[State 730, Character Flash Level 2]
type = PalFX
trigger1 = Power >= 2000 && Power < 3000
time = 1
add = ceil((50+25*((Power-2000)/1000.0))+(sin(Time/6.0*pi)*(50+25*((Power-2000)/1000.0)))), ceil((0+25*((Power-2000)/1000.0))+(sin(Time/6.0*pi)*(0+25*((Power-2000)/1000.0)))), ceil((50-50*((Power-2000)/1000.0))+(sin(Time/6.0*pi)*(50-50*((Power-2000)/1000.0))))

[State 730, Character Flash Level 3]
type = PalFX
trigger1 = Power >= 3000
time = 1
add = 75 + ceil(sin(Time / 6.0 * pi) * 75), 25 + ceil(sin(Time / 6.0 * pi) * 25), 0

[State 730, Power Charge Helper]
type = Helper
trigger1 = !NumHelper(8330)
helperType = Normal
stateNo = 8330
ID = 8330
name = "Power Charge"
posType = P1
pos = 0,0
pauseMoveTime = 65535
superMoveTime = 65535
ownPal = 1

[State 730, Particles]
type = Helper
trigger1 = !NumHelper(8331)
helperType = Normal
stateNo = 8331
ID = 8331
name = "Particles"
postype = P1
pauseMoveTime = 65535
superMoveTime = 65535
ownPal = 1

[State 730, End]
type = ChangeState
triggerall = time >= 8
trigger1 = power >= const(data.power) || power >= powermax || roundstate != 2
trigger2 = !AIlevel && (command != "hold_b" || command != "hold_y")
trigger3 = AIlevel && (inguarddist || p2bodydist x <= 120)
trigger4 = (var(58)&&sysfvar(4)>0)
value = 731
ctrl = 1


;Power Charge End
