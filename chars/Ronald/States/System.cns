type = DisplayToClipboard
text = "Damp = %d Limit = %d juggle = %d hit = %d  Front =%d Back = %d"
params = fvar(10) , fvar(8), var(15) , var(13) , frontedgebodydist , backedgebodydist
ignorehitpause = 1
[State -2, Debug 2]
type = AppendToClipboard
trigger1 = 1
text = "\nBy Sennou-Room"
ignoreHitPause = 1

[State -2, AILevel Reset]
type = VarSet
triggerall = !(StateNo = [5900,5901])
trigger1 = !NumPartner
trigger2 = NumPartner
trigger2 = Partner,AILevel>0
trigger3 = var(59)>8 || var(59)<1
var(59) = AILevel
ignoreHitPause = 1


