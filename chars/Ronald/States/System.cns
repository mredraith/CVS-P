;=== FINAL BOSS MODE ===
[State -2, Red Aura]
type=helper
triggerall= var(40)>=3; && var(20)<=0
triggerall= alive
triggerall= MoveType != H || (StateNo = [120,159]) || (StateNo = [5000,5999])
triggerall= !numhelper(8800)
triggerall= !(StateNo = [5900,5901])
trigger1= (StateNo != 193) || (StateNo = 193 && AnimElem = 3, >= 0)
helpertype=normal
stateno=8800
ID=8800
name="Aura"
postype=p1
pos=0,0
pauseMoveTime=9999
superMoveTime=9999
ownpal=1
ignorehitpause=1

[State -2, Beginning]
type = VarSet
trigger1 = var(40) = 3 && RoundState >= 2 && Ctrl
v = 40
value = 4

[State -2, PowerAdd]
type = PowerAdd
triggerall = alive && roundstate>=2 && var(40)>=4 && !var(20) && (stateno!=[740,750]) && (stateno!=[900,905]) && (stateno!=[3000,4000])
trigger1 = (stateno = [120,159]) || movetype != H
value = ifelse(GameTime % 2 = 0, 2, 1)
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

[State -3, Super Jump Flag Reset]
type = VarSet
trigger1 = StateType != A || MoveType = H
trigger2 = (StateNo = [1000,4999]) || (StateNo = [5000,5999]) || (StateNo = [6080,6082])
fvar(3) = 0

[State -3, Super Jump]
type = VelAdd
triggerall = fvar(3) && roundstate = 2 && vel x < const(velocity.jump.fwd.x)
triggerall = (stateno = [50,51]) || (stateno = [600,699]) || stateno = 850 || stateno = 906
trigger1 = !AILevel && command = "holdfwd"
trigger2 = AILevel && (p2bodydist x >= 45) && p2movetype != A && p2statetype = A
x = .1
[State -3, Super Jump]
type = VelAdd
triggerall = fvar(3) && roundstate = 2 && vel x > const(velocity.jump.back.x)
triggerall = (stateno = [50,51]) || (stateno = [600,699]) || stateno = 850 || stateno = 906
trigger1 = !AILevel && command = "holdback"
x = -.1

[State -3, Parry Detection]
type = Helper
triggerAll = RoundState = 2 && !NumHelper(6090) ;&& !var(20)
triggerAll = (MoveType = I && ctrl) || ((StateNo = [6080,6082]) && Time >= 7) || ((StateNo = 5120 || StateNo = 5201) && AnimTime >= -8) || (StateNo = 5210 && Time >= 13)
triggerAll = (command != "rlsfwd" && command != "rlsback" && command != "rlsup" && command != "rlsdown") || AILevel
trigger1 = !AIlevel && (StateType = S || StateType = C || StateNo = 5120) && (ifElse(P2dist x >= 0, command = "fwd", command = "back") || command = "down")
trigger2 = !AIlevel && StateType = A && (ifElse(P2dist x >= 0, command = "fwd", command = "back"))
trigger3 = AIlevel && (StateNo != [6080, 6082]) && InGuardDist && Random < 50
trigger4 = AIlevel && (StateNo = [6080, 6082]) && Time = 14 && Random < 667
stateNo = 6090
ID = 6090
name = "Parry Detection"
posType = P1
pauseMoveTime = 65535
superMoveTime = 65535

[State -3, Parry Attacks]
type = ChangeState
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = Helper(6090), StateNo = 6091
value = ifElse((Helper(6090), Anim = 6092), 6082, ifElse((Helper(6090), Anim = 6091), 6081, 6080))
ignoreHitPause = 1

[State -3, Parry Projectiles]
type = HitOverride
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = !(Helper(6090), var(0)) && (Helper(6090), Anim = 6090)
attr = SA, AP
stateNo = 6080
slot = 0
time = 1
ignoreHitPause = 1

[State -3, Parry Projectiles]
type = HitOverride
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = !(Helper(6090), var(0)) && (Helper(6090), Anim = 6091)
attr = C, AP
stateNo = 6081
slot = 0
time = 1
ignoreHitPause = 1

[State -3, Parry Projectiles]
type = HitOverride
trigger1 = (StateNo != [6080,6082]) && NumHelper(6090)
trigger1 = !(Helper(6090), var(0)) && (Helper(6090), Anim = 6092)
attr = SCA, AP
stateNo = 6082
slot = 0
time = 1
ignoreHitPause = 1

[State -3, Assert: NoWalk after Parry]
type = AssertSpecial
trigger1 = fvar(16) > 0
trigger1 = fvar(16) := (fvar(16)-1)
flag = NoWalk
ignoreHitPause = 1

[State -3, Corner Push]
type=VarSet
triggerAll=fvar(5)
trigger1=abs(fvar(5)) <= (1 / 0.85)
trigger2=NumTarget
trigger2=Target, GetHitVar(HitTime) <= 0 || (Target, GetHitVar(HitShakeTime) > 0 && Target, Time <= 0)
fvar(5)=0
[State -3, Corner Push]
type=VarSet
trigger1=NumTarget
trigger1=Target, GetHitVar(HitShakeTime) <= 0
fvar(5)=fvar(5) * 0.85
[State -3, Corner Push]
type=VarSet
triggerall=movetype != H
trigger1=MoveContact=1 && NumTarget
