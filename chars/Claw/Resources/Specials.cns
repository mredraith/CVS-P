;------------------------------------------------------------------
; Flying Barcelona Attack (Wall Jump)
[Statedef 1103]
type = A
movetype = I
physics = N
anim = 1103
velset = 0,0
poweradd = 4*var(5)

[State 1103,Turn]
type = Turn
trigger1 = Time=0 && !(enemynear,backedgebodydist <=0 && var(2)=1)

[State 1103,PlaySnd]
type = PlaySnd
trigger1 = Time=0
value = 1000,0
channel = 0

[State 1103,VelSet]
type = VelSet
trigger1 = Time=0
x= ifelse((enemynear,backedgebodydist <=0 && var(2)=1),-1.5,ifelse(P2bodydist X<20,0,ifelse(Abs((P2Dist X -58) / 43)<1.5,1.5,ifelse(Abs((P2Dist X -58) / 43)<2.5,2.5,Abs((P2Dist X -58) / 43)))))
y = -11.5-(Pos Y>-35)*.5;-10.25;-8.5

[State 1103,VelSet]
type = VarSet
trigger1 = Time=0
fvar(15)=Vel X

[State 1103]
type = VelAdd
trigger1 = Time>=0
y = .68;.6;.55

[State 1450]
type = VelSet
trigger1 = command!="holdfwd" && command!="holdback"
x = fvar(15)

[State 1103,VelAdd]
type = VelSet
trigger1 = command="holdfwd" || command="holdback"
x = fvar(15)+ifelse(command="holdfwd",4.5,-4.5);ifelse(command="holdfwd",4.25,-4.25)

[State 1130,ChangeState]
type = ChangeState
triggerall = Vel Y > 0 && AIlevel
trigger1 = (P2BodyDist X = [-64,64]) && var(10)=1 && var(31)>600
trigger1 = Pos Y < -44 && Pos Y > -52
value = Ifelse(var(10)=3, 1150, 1120)

[State 1130,ChangeState]
type = ChangeState
triggerall = Vel Y > 0 && AIlevel
triggerall = ((P2BodyDist X = [-64+vel X*4,64+vel X*4])||((P2BodyDist X = [-78+vel X*4,78+vel X*4]) && var(31)<400)) && var(10)!=1
trigger1 = Pos Y < -52 && Pos Y > ifelse(var(31)<600,-82,-64)
trigger2 = P2Statetype=A && Pos Y >-85 && Pos Y <-65 && (P2BodyDist Y <50) && enemynear,Vel Y<0
value = Ifelse(var(10)=3, 1150, 1120)

[State 1103,Attack]
type = ChangeState
triggerall = Vel Y > 0 && !AIlevel
trigger1 = command="pp"
value = Ifelse(var(10)=3, 1150, 1120)

[State 1103,Attack]
type = ChangeState
triggerall = Vel Y > 0 && !AIlevel
trigger1 = (command="x" || command="y" || command="z")
value = Ifelse(var(10)=3, 1140, 1110)

[State 1103,Exit]
type = ChangeState
trigger1 = pos y > -vel y
value = 1104
