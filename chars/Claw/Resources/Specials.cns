guardsound=s130, 0
ground.type = High
ground.slidetime = 15
ground.hittime = 15
guard.hittime = (15) - 6
ground.velocity = -5.0
air.velocity = -5.0,-6.0
air.hittime = 13
yAccel = (0.5 + (ComboCount * 0.04))
getpower=16* !var(20),8* !var(20)
givepower=16,16
forcestand = 1
air.fall = 1
fall.recover = 0
air.recover = 0
ground.cornerpush.veloff = -9.0
air.cornerpush.veloff = 0
priority = 7, Hit
palFX.time=10 * var(9)
palFX.add=255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time=10
envshake.ampl=Ifelse(random<=500,-3,3)
id = 1000

[State 1000,varset]
type = varAdd
trigger1 = Anim=1010 && AnimElem=1,=1 && var(2)>0
var(2)=-1

[State 1000, Landing Dust Explod]
type = Explod
trigger1 = AnimTime = 0
anim = 8102
sprPriority = -3
posType = P1
scale = 0.5,0.5
pauseMoveTime = -1
superMoveTime = -1
ownPal = 1

[State 52, PlaySnd]
type = PlaySnd
trigger1 = AnimTime = 0
value = 52, 0

[State 1000,ChangeState]
type = ChangeAnim
trigger1 = Animtime=0 && var(2)
value = 1010

[State 410, Dust Helper]
type = Helper
trigger1 = anim = 1000 && AnimElem = 2
helperType = Normal
stateNo = 8103
ID = 8100
name = "Slide Dust"
posType = p1
pauseMoveTime = 255
superMoveTime = 255
ownPal = 1

[State 1000,ChangeState]
type = ChangeState
trigger1 = Animtime=0 && !var(2)
value = 1020

