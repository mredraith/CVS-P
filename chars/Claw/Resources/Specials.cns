; Flying Barcelona Attack (Start)
[Statedef 1100]
type=S
movetype=A
physics=N
ctrl=0
velset=0,0
poweradd=72 * !var(20)
sprpriority=1
facep2=1

[State 1100,varset]
type = varset
trigger1 = !Time
var(10) = 0

[State 40, Snd]
type = playsnd
trigger1 = AnimElem=2
value = 41, 0
[State 40, Dust]
type = helper
trigger1 = AnimElem=2
helpertype = normal
stateno = 8100
ID = 8100
name = "Jump Dust"
postype = p1
ownpal = 1

[State 1100,varset]
type = varset
trigger1 = !Time && !AILevel
var(2) = ifelse(command="holdfwd",1,ifelse(command="holdback",-1,ifelse((BackEdgeBodyDist-FrontEdgeBodyDist)>=0,1,-1)))

[State 1100,varset]
type = varset
trigger1 = !Time && AILevel
var(2) = ifelse((FrontEdgeBodyDist <70 && random <400),1,-1)

[State 1100,varset]
type = ScreenBound
trigger1 = var(2)=1&&Anim=1100 && time<26;FrontEdgebodydistłȂAP2bodydist Ŕf
value = 0
movecamera = 1,0

[State 1100,varset]
type = ScreenBound
trigger1 = var(2)=1&&Anim=1100&&time>=26 && time<28 && Vel X>=6
value = 1

[State 1100,ChangeAnim]
type = ChangeAnim
trigger1 = time=0
value = 1100+(var(2)=-1)*1

[State 1100,ChangeAnim]
type = ChangeAnim
trigger1 = time=0 && (PrevStateNo=[1200,1220])
value = 1100+(var(2)=-1)*1

[State 1100,PlaySnd]
type = PlaySnd
trigger1 = Time=0
value = 1100,0
channel = 0

[State 1100,StatetypeSet]
type = StatetypeSet
trigger1 = (Anim=1100 || Anim=1101) && AnimElem=2,=0
Statetype = A
physics = N

[State 1100,VelSet_back]
type = VelSet
triggerall = (Anim=1100 || Anim=1101) && AnimElem=2,=0
trigger1 = var(2)=-1
x = -9;-8.7+(4*(200-BackEdgeBodyDist)/86)
y = -8.0;-7.8;-9.6

[State 1100,VelSet_fwd]
type = VelSet
triggerall = (Anim=1100 || Anim=1101) && AnimElem=2,=0
trigger1 = var(2)=1
x = 9;8.7-ifelse(FrontEdgeBodyDist <=200,(4*(200-FrontEdgeBodyDist)/86),0)
y = -8.0;-7.8;-9.6

[State 1100,VelMul]
type = VelMul
trigger1 = (Anim=1100 || Anim=1101) && AnimElem=2,=0&&var(2)=-1
x = 1.5;+ifelse(backedgebodydist>200,.25,ifelse(Backedgebodydist>120,((backedgebodydist-80)/60)*.12,0))

[State 1100,VelMul]
type = VelMul
trigger1 = (Anim=1100 || Anim=1101) && AnimElem=2,=0&&var(2)=1
x = 1.5;+ifelse(frontedgebodydist>200,.25,ifelse((frontedgebodydist>120&&var(2)=-1),((frontedgebodydist-80)/60)*.12,0))

[State 1100,VelAdd]
type = VelAdd
trigger1 = (Anim=1100 || Anim=1101) && AnimElemTime(2)>=0
y = .4;*1.2


[State 51, Landing]
type = ChangeState
triggerall = AnimElemTime(2)>0
trigger1 = pos y > -vel y
value = 1104

[State 1100,ChangeState]
type = ChangeState
trigger1 = Anim=1100
trigger1 = FrontEdgeDist <= 20 && Pos Y<-25
trigger2 = Anim=1101
trigger2 = BackEdgeDist <= 20 && Pos Y<-25
value = 1102
