;------------------------------------------------------------------
; Rolling Crystal Flash
[Statedef 1000]
type=S
movetype=A
physics=S
ctrl=0
velset=0,0
poweradd=72 * !var(20)
sprpriority=1
facep2=1

[State 1000, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))
[State 1000, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifelse(random<300,1,2)
[State 1000, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && prevstateno!=1000
value = 1000

[State 1000, Adjust]
type = VarSet
trigger1 = !Time && var(10)
var(2) = Ifelse(var(10)=2, 2, 1)

[State 1000,StateTypeSet]
type = StateTypeSet
trigger1 = Anim=1000 && AnimElem = 2
trigger2 = Anim=1010 && AnimElem=1,=1
statetype = A
physics = N

[State 1000,VelSet]
type = VelSet
trigger1 = Anim=1000 && AnimElem = 2
trigger2 = Anim=1010 && AnimElem = 1,=1
x = 4.5;3.5
y = (-5.0+(Anim=1010)*1)*ifelse(Anim=1010,2.5,2)

[State 1000,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 6,=2
trigger2 = Anim=1010 && AnimElem=4,=4
statetype = S
physics = S

[State 1000,VelSet]
type = VelSet
trigger1 = Anim=1000 && AnimElem = 6,=2
trigger2 = Anim=1010 && AnimElem=4,=4
y = 0

[State 1010,PosSet]
type = PosSet
trigger1 = Anim=1000 &&AnimElem = 6,=2
trigger2 = Anim=1010 && AnimElem=4,=4
y = 0

[State 1000,PlaySnd]
type = PlaySnd
trigger1 = Anim=1000 && AnimElem = 2
value = 1000,0
channel = 0

[State 1000,VelAdd]
type = VelAdd
triggerall = Pos Y<-4.5
trigger1 = Anim=1000 && AnimElem=2,>= 0
trigger2 = Anim=1010 && AnimElem=4,<4
y = .71*ifelse(Anim=1010,2.5,2)

[State 1000,HitDef]
type = HitDef
triggerall = Anim=1000
triggerall = !var(16) && (var(15) < 1 || var(20))
trigger1 = AnimElem=2 && !var(49)
trigger2 = AnimElem=3 && !movecontact && !movereversed
attr = A, SA
damage=ifElse(numtarget(1000), 6, 60+4*var(10)),4
animtype = Hard
guardflag = MA
hitflag = MAF
pausetime = 7, 7
sparkNo=-1 + 0 * (var(33) := 8013)
guard.sparkNo=-1 + 0 * (var(34) := 8001)
sparkXY=-10 + 0 * (var(35) := 120), var(36) := -30
hitsound=S2+10*var(44),2
guardsound=s130, 0
ground.type = High
ground.slidetime = 15
ground.hittime = 15
guard.hittime = (15) - 6
ground.velocity = -5.0
air.velocity = -5.0,-6.0
air.hittime = 13
yAccel = (0.5 + (ComboCount * 0.04))
getpower=16* !var(20),8* !var(20)
givepower=16,16
forcestand = 1
air.fall = 1
fall.recover = 0
air.recover = 0
air.cornerpush.veloff = 0
ground.cornerpush.veloff = -9.0
priority = 7, Hit
palFX.time=10 * var(9)
palFX.add=255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time=10
envshake.ampl=Ifelse(random<=500,-3,3)
id = 1000

[State 1000,HitDef]
type = HitDef
triggerall = !var(16) && (var(15) < 1 || var(20))
trigger1 = Anim=1000 && AnimElem=6
trigger2 = Anim=1010 && AnimElem=4
attr = A, SA
damage=ifElse(numtarget(1000), 6, 60+4*var(10)),4
animtype = Hard
guardflag = MA
hitflag = MAF
pausetime = 7, 7
sparkNo=-1 + 0 * (var(33) := 8013)
guard.sparkNo=-1 + 0 * (var(34) := 8001)
sparkXY=-10 + 0 * (var(35) := 120), var(36) := -20
