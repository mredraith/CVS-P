;var(6) : Cancel Flag
;var(7) : Able to Super Cancel
;var(8) : Able to Hyper Cancel
;var(9) : Counter Flag
;var(10) : Button Detect (0 = Light; 1 = Medium; 2 = Hard)
;var(11) : Button Detect for TNT Punch
;var(12) : Mashing Buttons during Knees of Hades
;var(13) : Hit Count
;var(15) : Juggle Points
;var(16) : Juggle Flag
;var(17) : Ticks UnGuardable
;var(18) : ProjContact (0 = No; 1 = Yes)
;var(19) : Throw Escape
;var(20) : Custom Combo Time
;var(21) : Super Cancel Flag
;var(22) : Hyper Cancel Flag
;var(23) : Super Finish Type (900 = Custom Combo; 3000 = Screw Upper; 3100 = Exploding Hurricane Tiger Heel; 3200 = Golden Tiger Kick; 3300 = Double Cyclone)
;var(25) : Ticks to Apply EX FX
;var(26) : Ticks Unable to Walk
;var(30) : Hit Detection
;var(31) : Hit Sound
;var(32) : Guard Sound
;var(33) : Hit Spark (8010 = Light; 8011 = Medium; 8012 = Hard; 8013 = Special; 8014 = Super)
;var(34) : Guard Spark (8000 = Normal; 8001 = Special)
;var(35) : Spark xPos
;var(36) : Spark yPos
;var(38) : Throw (0 = Allowed; 1 = Not Allowed)
;var(39) : Projectile Flag (0 = Off; 1 = On)
;var(40) : EX Golden Heel Flag (0 = can be performed; 1 = can't)
;var(41) : EX Golden Heel Guarded Flag (0 = can be performed; 1 = move guarded
;var(42) : Mashing Buttons during Knees of Hades Flag
;var(43) : Player ID to apply flames to
;var(44) : Knees of Hades Timer
;var(45) : Number of times pushed punch in succession
;var(46) : Punch Timer
;var(47) : EX Dragon Smash Hit Count
;var(58) : Game Time

