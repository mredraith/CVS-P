;Fire Blast
[StateDef 1000]
type = S
physics = S
moveType = A
anim = 1000
ctrl = 0
velset = 0,0
sprPriority = 2
poweradd = 70 * !var(20)
faceP2 = 1

[State 0, Button Detect]
type = VarSet
trigger1 = !Time
var(10) = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))

[State 0, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 0, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 500,0
channel = 0

[State 0, snd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 1,7
channel = 1

[State 0, Width]
type = Width
trigger1 = AnimElemTime(3) < 0
player = 35,0

[State 0, Projectile]
type = Helper
trigger1 = AnimElem = 3
helperType = Normal
stateNo = 1010
ID = 1010
name = "Fire Blast"
posType = P1
pos = 70,0
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1
size.xscale = 1
size.yscale = 1

;---------------------------------------------------------------------------

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 3000, power >= 0)
trigger1 = Command = "Inferno Breath"
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
value = 3100

;---------------------------------------------------------------------------

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 2000, power >= 0)
trigger1 = Command = "Hyper Rapid Kicks Max"
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
value = 3055

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 2000, power >= 0)
trigger1 = Command = "Balloon Bomb Max"
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
value = 3045

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 2000, power >= 0)
trigger1 = Command = "Super Fire Blast Max"
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
value = 3005

;---------------------------------------------------------------------------

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 1000, power >= 0)
trigger1 = Command = "Hyper Rapid Kicks"
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
value = 3050

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 1000, power >= 0)
trigger1 = Command = "Balloon Bomb"
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
value = 3040

[State 0, Follow Up]
type = ChangeState
triggerall = StateType = S
triggerall = ifelse(var(20) <= 0, power >= 1000, power >= 0)
trigger1 = Command = "Super Fire Blast"
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(5) < 0
value = 3000

;---------------------------------------------------------------------------

[State 0, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

