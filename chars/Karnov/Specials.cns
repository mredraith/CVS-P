;Balloon Attack
[Statedef 2000]
type    = A
movetype= A
physics = N
anim = 2000
ctrl = 0
velset = 0,0
poweradd = 70 * !var(20)
sprpriority = 2
facep2 = 1

[State 0, Button Detect]
type = VarSet
trigger1 = !Time
var(10) = ifElse((command = "a" || command = "rlsa"), 0, ifElse((command = "b" || command = "rlsb"), 1, 2))

[State 0, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || PrevStateNo = 750 || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 2000, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 510,0
channel = 0

[State 2000, StateTypeSet: Air, No Phys]
type = StateTypeSet
trigger1 = AnimElem = 1
stateType = A
physics = N

[State 2000, Rising Velocity]
type = VelSet
trigger1 = AnimElemTime(1) = 0
x = ifelse(var(10)=2,3, ifelse(var(10)=1, 0, -3))
y = ifelse(var(10)=2,0, ifelse(var(10)=1, 0, 0))

[State 2000, Gravity/Friction]
type = VelAdd
trigger1 = AnimElemTime(4) > 0
y = .6

[State 2000, Resist Projectiles]
type = NotHitBy
trigger1 = Animelem = 3
time = 12
value = SCA

[State 2000, Hit]
type = HitDef
trigger1 = !var(16) && var(15) < 3
trigger1 = !Time
attr = A, SA
damage = ceil(ifElse(fvar(11) * ifElse(var(10) = 2, 80, ifElse(var(10), 70, 60)) < 7, 7, fvar(11) * ifElse(var(10) = 2, 80, ifElse(var(10), 70, 60)))), 7
priority = 4, hit
animtype = Hard
getpower = 50 * !var(20), 30 * !var(20)
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,2
guardsound = S130,0
pausetime = 10,20
guard.pausetime = 10,10
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 36), var(36) := -33
air.animtype = Back
fall.animtype = Back
ground.type = High
air.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = (18) - 6
ground.velocity = -3, -3
air.velocity = -3, -3
guard.velocity = -3.5
airguard.velocity = -3.5, -3.5
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yAccel = (0.5 + (ComboCount * 0.03))
fall = 1
fall.recover = 0
forcestand = 0
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 14
envshake.ampl = 4
envShake.freq = 120

[State 2000, End]
type = ChangeState
trigger1 = pos y > -vel y
value = 52

