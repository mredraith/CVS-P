;Fire Breath
[Statedef 1050]
type = S
movetype = A
physics = S
anim = 1050
ctrl = 0
velset = 0,0
poweradd = 70 * !var(20)
sprpriority = 2
facep2 = 1

[State 1050, Button Detect]
type = VarSet
trigger1 = !Time
var(10) = ifElse((command = "a" || command = "rlsa"), 0, ifElse((command = "b" || command = "rlsb"), 1, 2))

[State 1050, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || PrevStateNo = 750 || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 1050, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 500,0
channel = 0

[State 1050, Snd]
type = PlaySnd
trigger1 = Animelem = 4
value = 500, 1
channel = 1

[State 0, FX]
type = Explod
trigger1 = AnimElem = 4
anim = 1051
ID = 1051
postype = p1
pos = 0,0
bindtime = -1
sprpriority = 5
ownpal = 1
removeongethit = 1
ignorehitpause = 0
persistent = 0
ontop = 0
scale = 1,1

[State 0, Shield]
type = Helper
trigger1 = AnimElem = 4
helperType = Normal
stateNo = 3010
ID = 3010
name = "Shield"
posType = P1
pos = 0,0
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1
size.xscale = 1
size.yscale = 1

[State 0, Flame Particles]
type = Helper
trigger1 = !NumHelper(8150)
trigger1 = MoveHit = 1 && NumTarget
trigger1 = !(Target, HitShakeOver)
trigger1 = var(40) := (Target, ID)
helperType = Normal
stateNo = 8150
ID = 8150
name = "Flame Particles"
posType = P2
ownPal = 1
ignoreHitPause = 1

[State 1050, HitDef] 
type = HitDef
trigger1 = !var(16) && var(15) < 3
trigger1 = !Time
attr = S, SA
damage = ceil(ifElse(fvar(11) * (ifElse(var(10) = 2, 90, ifElse(var(10), 80, 70)) * (ifElse(var(20), 1.1, 1))) < 7, 7, fvar(11) * (ifElse(var(10) = 2, 90, ifElse(var(10), 80, 70)) * (ifElse(var(20), 1.1, 1))))), 8
priority = 4, hit
animtype = Hard
getpower = 70 * !var(20), 30 * !var(20)
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,6
guardsound = S130, 0
pausetime = 12,12
guard.pausetime = 12,12
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 140), var(36) := -57
air.animType = Back
fall.animType = Back
ground.type = High
air.type = Low
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = (18) - 6
ground.velocity = -5, -5
air.velocity = -5, -5
guard.velocity = -5.5
airguard.velocity = -5.5, -5.5
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yAccel = (0.5 + (ComboCount * 0.03))
fall = 1
fall.recover = 0
forcestand = 0
palfx.time = 60
palfx.add = 224,68,-40
palfx.mul = 256,192,128
palfx.sinadd = -160,-160,-160,14
palfx.color = 0
palfx.invertall = 1
envshake.time = 20
envshake.ampl = 4
envShake.freq = 140

[State 1050, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(6) >= 0
movetype = I

[State 1050, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

