[State 50, Anim]
type = changeanim
trigger1 = var(3) = 2
value = ifelse(!(vel x), 51, ifelse((vel x) > 0, 52, 53))
elem = animelemno(0)
persistent = 0


[State 50, Assert: No Guard]
