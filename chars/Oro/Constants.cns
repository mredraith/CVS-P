victory35 = "Nice to meet you!"
victory36 = "I have some free time to kill."
victory37 = "Hmm... Peculiar..."
victory38 = "Hmm, weak! You're weak"
victory39 = "Your moves are deadly... They could kill me by boring me to death!"
victory40 = "Keep it up and you'll suffer the horror of pain!"
victory41 = "If we went home right now, would anyone really care? Probably not."
victory42 = "Would you like to meet my pets? Or are you too injured?"
victory43 = "If I kept fighting against you, I might actually get worse!"
