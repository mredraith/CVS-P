;Jumping=
[StateDef 40]
type = S
physics = S
moveType = I
anim = 40
ctrl = 0
velSet = 0,0
sprPriority = 1
faceP2 = 1

[State 40, Direction]
type = varset
trigger1 = !AIlevel
sysvar(1) = ifElse(!Time, 0, ifElse(command = "holdfwd", 1, ifElse(command = "holdback", -1, sysvar(1))))

[state 40, AI Jump Direction]
type = varset
trigger1 = ailevel && !time
sysvar(1) = 1 - random % 3
[state 40, AI Jump Direction]
type = varset
triggerall = ailevel
trigger1 = p2movetype = A
trigger1 = p2bodydist x < 40
trigger1 = random < 500 * (ailevel ** 2.0 / 64.0)
sysvar(1) = -1
[state 40, AI Jump Direction]
type = varset
triggerall = ailevel
;
trigger1 = backedgedist < 32 && p2bodydist x < 75
trigger1 = p2movetype = A && p2statetype != A
trigger1 = random < 640 * (ailevel ** 2.0 / 64.0)
;
trigger2 = numtarget
trigger2 = target,statetype = A && target,vel x < 0
sysvar(1) = 0
[state 40, AI Jump Direction]
type = varset
triggerall = ailevel
trigger1 = p2bodydist x > 75
trigger1 = random < 640 * (ailevel ** 2.0 / 64.0)
;
trigger2 = p2bodydist x > 40 && enemynear,time >= 8
;
trigger3 = numtarget
trigger3 = target,statetype = A && target,vel x < -1
;
trigger4 = p2stateno = 5120
sysvar(1) = 1

[State 40, High Jump]
type = varset
trigger1 = !time && !AIlevel
var(3) = ifelse(command = "highjump", 3, 0)
[State 40, AI High Jump]
type = varset
trigger1 = !time && AIlevel
var(3) = cond(p2bodydist x > 160 && (p2stateno = 5120 ||(p2movetype = A && p2statetype != A)) || random < (150 * (ailevel ** 2.0 / 64.0)), 3, 0)

[State 40, High Jump]
type = VarSet
trigger1 = !Time && PrevStateNo = 100
var(3) = 3

[State 40, Low Jump]
type = varset
trigger1 = !AIlevel && command != "holdup" && (var(3) != [1, 2])
var(3) = ifelse((var(3) = 3 && sysvar(1)), 2, 1)
[State 40, AI Low Jump]
type = varset
triggerall = ailevel
triggerall = !time
triggerall = var(3) != [1, 2]
triggerall = p2bodydist x < 120
; condition
trigger1 = p2statetype = C && p2movetype != A
; condition
trigger2 = p2statetype = S && p2movetype = I 
var(3) = ifelse((var(3) = 3 && sysvar(1)), 2, 1)

[State 40, Changestate]
type = ChangeState
triggerall = ailevel && numenemy
triggerall = enemynear,hitdefattr != SC,AT
triggerall = enemynear,statetype != L
; condition
trigger1 = p2bodydist x < 40
trigger1 = random < 640 * (ailevel ** 2.0 / 64.0)
; condition
trigger2 = p2bodydist x < 90 && frontedgebodydist > 60
value = 0
ctrl = 1

[State 40, Jump Sound]
type = PlaySnd
trigger1 = !AnimTime
value = ifElse((var(3) = [2,3]), 41, 40), 0

[State 40, Dust Helper]
type = Helper
trigger1 = !AnimTime
stateNo = 8100
ID = 8100
name = "Jump Dust"
posType = P1
ownPal = 1

[State 40, Velocity: Normal Jump]
type = VelSet
trigger1 = !AnimTime
x = ifElse(!sysvar(1), const(velocity.jump.neu.x), ifElse(sysvar(1) = 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, Velocity: Low Jump]
type = VelSet
trigger1 = !AnimTime && var(3) = 1
x = ifElse(!sysvar(1), const(velocity.jump.neu.x), ifElse(sysvar(1) = 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = 0.75 * const(velocity.jump.y)

[State 40, Velocity: Long Low Jump]
type = VelSet
trigger1 = !AnimTime && var(3) = 2
x = ifElse(!sysvar(1), const(velocity.jump.neu.x), ifElse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = 0.75 * const(velocity.jump.y)

[State 40, Velocity: Long Jump]
type = VelSet
trigger1 = !AnimTime && var(3) = 3
x = ifElse(!sysvar(1), const(velocity.jump.neu.x), ifElse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = 1.0772 * const(velocity.jump.y)

[State 40, End]
type = ChangeState
trigger1 = !AnimTime
value = 50
ctrl = 1

