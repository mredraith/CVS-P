;---------------------------------------------------------------------------
;Projectile
[Statedef 1000]
type = S
physics = S
movetype = A
anim = 1000
ctrl = 0
velset = 0, 0
poweradd = 70 * !var(20)
sprpriority = 1
facep2 = 1

[State State 0, Liquid Sound]
type = PlaySnd
trigger1 = !Time
value = s20,3
channel = 1

[State 1000, Strength]
type = varset
trigger1 = !time && !AIlevel
var(10) = ifelse(command = "z", 2, ifelse(command = "y", 1, 0))

[State 1000, Strength AI]
type = varset
trigger1 = !time && AIlevel
var(10) = ifelse((p2dist y <= -60 || random < 500), 2, ifelse(random < 500, 1, 0))

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !Time
value = Anim + Var(10)

[State 1000, width]
type = width
trigger1 = animelemtime(10) = 0 && Var(10) <= 1
value = 30, 0

[State 1000, Hadouken]
type = helper
trigger1 = animelemtime(10) = 1 && Var(10) <= 1
helpertype = normal
stateno = 1005
ID = 1005
name = "Hadouken"
postype = p1
pos = 70, -68
size.xscale = 0.5
size.yscale = 0.5
ownpal = 1

[State 1000, Snd]
type = playsnd
trigger1 = animelem = 8 && Var(10) <= 1
trigger2 = AnimElem = 7 && Var(10) >= 2
value = 1000, 0 + Var(10)
channel = 0

[State 1000, Snd]
type = playsnd
trigger1 = animelemtime(10) = 1 && Var(10) <= 1
trigger2 = AnimElem = 7 && Var(10) >= 2
value = 1005, ifelse(Var(10) = 2 , 1,0)

[State 1000, Kouou Ken]
type = helper
triggerall = Var(10) >= 2
trigger1 = animelem = 8,5
helpertype = normal
stateno = 1015
ID = 1005
name = "Energy Rings Diag"
postype = p1
pos = 20, -100
size.xscale = 1
size.yscale = 1
ownpal = 1

[State a1200, 2at]
type = Explod
triggerall = Var(10) >= 2
trigger1 = animelem = 8
anim = 1014
scale = const(size.xscale),const(size.yscale)
sprpriority = 4
bindtime = -1
pos = 17,-92
ownpal = 1
removeongethit = 1

[State 1000, End]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

