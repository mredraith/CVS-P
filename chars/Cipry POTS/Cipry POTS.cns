value = SCA
time = 1

[State 181, 2]
type = PlaySnd
trigger1 = AnimElem = 1
value = 180, 0

[State 190, 0]
type = ChangeState
trigger1 = Time <= 0
trigger1 = PalNo != 7
trigger1 = Random <= 500
trigger2 = PalNo >= 10
value = 182

