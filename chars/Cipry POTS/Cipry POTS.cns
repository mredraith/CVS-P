ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
; CNS x: {
[Statedef 180]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 180, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, 1]
type = ChangeState
trigger1 = PalNo = 7
value = 182

[State 180, 2]
type = PlaySnd
trigger1 = AnimElem = 1
value = 180, 0

[State 190, 0]
type = ChangeState
trigger1 = Time <= 0
trigger1 = PalNo != 7
trigger1 = Random <= 500
trigger2 = PalNo >= 10
value = 181

