type    = A
movetype= A
physics = N
juggle  = 4
velset = 1,-8
ctrl = 0
sprpriority = 2

[State 1100, 1]
type = VelAdd
trigger1 = 1
y = .4

[State 1100, 3]
type = HitDef
trigger1 = AnimElem = 8
attr = A, SA
animtype  = Heavy
damage    = 50, 10
priority  = 5
guardflag = MA
pausetime = 12,12
sparkxy = 0,-110
sparkno = -1 + 0 * (var(33) := 8012)
guard.sparkno = -1 + 0 * (var(34) := 8000)
hitsound   = S2,3
guardsound = S3,0
ground.type = Low
ground.slidetime = 15
ground.hittime  = 18
guard.hittime = (18) - 6
ground.velocity = -2,-10
guard.velocity = -6
air.velocity = -2,-8
airguard.velocity = -4,-4
p2facing = 1
air.fall = 1
fall = 1                   ;Make p2 fall down
yAccel = (0.5 + (ComboCount * 0.04))

[State 1100, 3]
type = PosAdd
trigger1 = AnimElem = 10
x = 20

[State 1100, 4]
type = ChangeState
triggerall = Time >= 10
trigger1 = Vel Y > 0
trigger1 = Pos Y > 0
value = 52

