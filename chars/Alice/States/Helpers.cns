;Wolf One Proj
[Statedef 1205]
type=A
movetype=A
physics=N
anim=1205
ctrl=0
velset=0, 0
sprpriority=4

[State 1205, Counter Flag]
type=VarSet
trigger1=!time
var(9)=root,var(9)

[State 1205, Strength]
type=varset
trigger1=!time
var(10)=root,var(10)

[State 1205, HitOverride]
type=hitoverride
trigger1=1
time=-1
attr=SCA, AA, AP, AT
stateno=1206
ignorehitpause=1
[State 1205, HB]
type=hitby
trigger1=1
time=-1
value=SCA, NP, SP, HP
ignorehitpause=1

[State 1205, Vel]
type=velset
trigger1=animelem=2
x=1+var(10)

[State 1205, HitSound]
type=playsnd
trigger1=movehit && numtarget
trigger1=target, time=0 && target, movetype=H
value=s2, 6
channel=16+random%5
persistent=0
ignorehitpause=1
[State 1205, Trans]
type=Trans
trigger1=1
trans=addalpha
alpha=256,256
ignorehitpause=1

[State 1205, AssertSpecial]
type=AssertSpecial
trigger1=1
flag=noshadow
ignorehitpause=1

[State 1205, Low]
type=hitdef
trigger1=!time
priority=4, Hit
attr=S, SP
damage=floor(35*root,fvar(10)),7
animtype=Hard
hitflag=MAF
guardflag=M
pausetime=1,Ifelse((root,var(20)), 6, 12)
sparkNo=-1
guard.sparkNo=-1
sparkXY=-1
guardsound=s130,1
ground.type=Low
ground.slidetime=12
ground.hittime=18
guard.hittime = (18) - 6
air.hittime=32
ground.velocity=Ifelse(root,var(20),-2,-4)
guard.velocity=Ifelse(root,var(20),-2,-4)
air.velocity=Ifelse(root,var(20),-2,-4), -3
airguard.velocity=Ifelse(root,var(20),-2,-4),-5
ground.cornerPush.velOff=0
guard.cornerPush.velOff=0
air.cornerPush.velOff=0
getpower=Ifelse(var(10)=3,0,36)*!(root,var(20)),Ifelse(var(10)=3,0,18*!(root,var(20)))
givepower=36, 36
envshake.time=12
envshake.ampl=4
sprpriority=4
yAccel = (0.5 + (ComboCount * 0.04))
air.fall=1
fall.recover=0
airguard.ctrltime=12
envshake.time=10
envshake.ampl=3
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd=-255,-255,-255,48

[State 1205, HitSpark]
type=Helper
trigger1=movecontact=1 && numtarget
trigger1=(enemynear, movetype=H) && !(target, time)
helperType=Normal
stateNo=ifElse(MoveGuarded, 8001, 8013)
ID=8000
name="Spark"
posType=P1
pos=(target, const(size.ground.front) -10), 0
facing=-1
ownPal=0
size.xScale=1
size.yScale=1
pauseMoveTime=65535
superMoveTime=65535
ignoreHitPause=1
persistent=0

[State 1205, Sparkles]
type=helper
trigger1=movehit && numtarget && !numhelper(1006)
trigger1=!(target, time) && (target, movetype=H)
trigger1=(enemynear,stateno=[5000,5050])
helpertype=normal
stateno=1006
ID=1006
name="Sparkles"
postype=p2
pos=0,-70
size.xscale=0.25
size.yscale=0.25
ownpal=1
ignorehitpause=1

[State 1205, Counter FX]
type=Helper
trigger1=MoveContact=1 && NumTarget && var(9)
trigger1=!(Target, HitShakeOver)
helperType=Normal
stateNo=8290
ID=8290
name="Counter FX"
posType=P1
pos=ifElse(P2Dist x < 0, 0, ifElse(P2Dist x < 20, ceil(P2Dist x), 20)), 0
ownPal=1
pauseMoveTime=65535
superMoveTime=65535
ignoreHitPause=1
persistent=0

[State 1205, HitCount]
type=ParentVarAdd
trigger1=Movehit=1 && NumTarget
var(13)=1
ignoreHitPause=1
persistent=0
[State 1205, Juggle]
type=parentvaradd
trigger1=movecontact=1 && numtarget
var(15)=1
ignorehitpause=1
persistent=0
[State 1205, ProjContact]
type=VarSet
trigger1=MoveContact=1 && NumTarget
var(18)=1
ignorehitpause=1
persistent=0
[State 1205, ProjContact]
type=ParentVarSet
trigger1=MoveContact=1 && NumTarget
trigger1=Root,StateNo=1200||Root,StateNo=1250
var(18)=1
ignorehitpause=1
persistent=0

[State 1205, End]
type=changestate
trigger1=movecontact
trigger2=animelemtime(6)>=0
value=1206
ignorehitpause=1
[State 1205, End]
type=destroyself
trigger1=!animtime
