;--------------------------------------------------------------------------------------
;Pal Select
[Statedef 256]
physics=N
anim=256
velset=0,0
sprpriority=99999
 
[State 256, PosSet]
type=PosSet
trigger1=!time 
x=root,facing*-90
y=20
ignorehitpause=1

[State 256, AS]
type=assertspecial
trigger1=1
flag=intro
flag2=noshadow
[State 256, AS]
type=assertspecial
trigger1=root,AILevel
flag=invisible

[State 256, Reset]
type=varset
trigger1=!time
var(29)=200
[State 256, Pal]
type=varset
trigger1=!time
var(26)=root,palno

[State 256, Varset]
type=varset
trigger1=var(26)<1||var(26)>25
var(26)=1+(var(26)<1)*24

[State 256, PlaySnd]
type=PlaySnd
trigger1=var(10)=2 
value=S256,0
volumescale=50
channel=20
[State 256, PlaySnd]
type=PlaySnd
triggerall=ishelper(256)
trigger1=root,command="a"||root,command="b"||root,command="c"||root,command="x"||root,command="y"||root,command="z"||root,command="s"||roundstate=2
trigger2=var(29)<=5
value=S256,1
volumescale=50
channel=20
persistent=0 

[State 256, Countdown]
type=VarAdd
trigger1=1 
var(29)=-1
[State 256, Countdown]
type=VarAdd
trigger1=!var(10)&&var(29)<150
trigger1=root,command="holdup"||root,command="holddown"||root,command="holdback"||root,command="holdfwd"
var(29)=25

[State 256, Varadd]
type=varadd
trigger1=!var(10)
trigger1=root,command="holdup"||root,command="holddown"||root,command="holdback"||root,command="holdfwd"
var(26)=1-(root,command="holddown"||root,command="holdback"&&facing=1||root,command="holdfwd"&&facing=-1)*2

[State 256, Varadd]
type=varadd
trigger1=(root,command="holdup"||root,command="holddown"||root,command="holdback"||root,command="holdfwd")&&!var(10)||var(10)
var(10)=1

[State 256, Varset]
type=varset
trigger1=!time||var(10)>=17
var(10)=0

[State 256, End]
type=destroyself
triggerall=ishelper(256)
trigger1=root,command="a"||root,command="b"||root,command="c"||root,command="x"||root,command="y"||root,command="z"||root,command="s"||roundstate=2
trigger2=var(29)<=0
trigger3=root,AILevel && time>2
;-------------------------------------------------------------------
;The World SHP
[StateDef 811]
physics=N
anim=811
velset=0,0
sprPriority=0
ctrl=0

[State 811, Hit Frame]
type=ChangeAnim
trigger1=root,animelemtime(2)=[0,1]
value=811
elem=2
ignorehitpause=1
[State 811, Hit Frame]
type=ChangeAnim
trigger1=root,animelemtime(3)=[0,1]
value=811
elem=3
ignorehitpause=1
[State 811, Hit Frame]
type=ChangeAnim
trigger1=root,animelemtime(4)=[0,1]
value=811
elem=4
ignorehitpause=1
[State 811, Hit Frame]
type=ChangeAnim
trigger1=root,animelemtime(5)=[0,1]
value=811
elem=5
ignorehitpause=1
[State 811, Hit Frame]
type=ChangeAnim
trigger1=root,animelemtime(6)=[0,1]
value=811
elem=6
ignorehitpause=1

[State 811, BindToRoot]
type=BindToRoot
trigger1=1 
pos=ceil(0*root,const(size.xscale)),ceil(0*root,const(size.yscale))
ignorehitpause=1

[State 811, End]
type=DestroySelf
trigger1=root,stateno!=810
trigger2=!animtime
trigger3=root,movetype=H
trigger4=root,animelemtime(7)>=0
ignorehitpause=1
;-----------------------------------------------------------------------------------------------------
;SouthTown Var FX
[StateDef 1005]
physics=N
ctrl=0
anim=1005
sprPriority=-2

[State 1005, AssertSpecial]
type=AssertSpecial
trigger1=1
flag=noshadow
ignorehitpause=1
[State 1005, Assert]
type=trans
trigger1=1
trans=addalpha
alpha=256-(Ifelse(root,movecontact,32,16)*time), 256
ignorehitpause=1

[State 1005, BindToRoot]
type=BindToRoot
trigger1=time<2
pos=ceil(-10 * root,const(size.xScale)), ceil(0 * root,const(size.yScale))
ignorehitpause=1

[State 1005, End]
type=DestroySelf
trigger1=root,Movetype=H
trigger2=(root,stateno=1000||root,stateno=1050) && root,animelemtime(5)>=0
trigger3=root,stateno!=1000 && root,stateno!=1050 && root,stateno!=3000 && root,stateno!=3050
trigger4=root,time<=1
trigger5=time>12
ignorehitpause=1
;-----------------------------------------------------------------------------------------
;Sparkle Holder
[Statedef 1006]
physics=N
velset=0,0
anim=9999
sprpriority=0

[State 1006, Assert]
type=assertspecial
trigger1= 1
flag=noshadow
ignorehitpause=1

[State 1006, VarSet]
type=VarSet
trigger1=time%2
fvar(1)=(0.25 - 0.05 * cos(time / 5.0 * pi))

[State 1006, Charging Sound]
type=PlaySnd
trigger1=!Time
value=1006,0
channel=8
volumescale=50

[State 1006, Sparkles]
type=helper
trigger1=time
helpertype=normal
stateno=1007
ID=1007
name="Sparkles"
postype=p2
pos=-random%6*12,-70
size.xscale=fvar(1)
size.yscale=fvar(1)
pauseMoveTime=255
superMoveTime=255
ownpal=0
ignorehitpause=1

[State End]
type=destroyself
trigger1= !numenemy || time>=12
;-----------------------------------------------------------------------------------------
;Sparkles
[Statedef 1007]
physics=N
anim=1007
velset=0,-8+random%4
sprpriority=-5+random%10

[State 1007, Assert]
type=trans
trigger1=1
trans=addalpha
alpha=256, 256
ignorehitpause=1

[State 1007, VarSet]
type=VarSet
trigger1=!time 
var(2)=random%12*30

[State 1007, AngleDraw]
type=AngleDraw
trigger1=1
value=var(2)
ignorehitpause=1

[State 1007, Assert]
type=assertspecial
trigger1= 1
flag=noshadow
ignorehitpause=1

[State 1007, VarRandom]
type=VarRandom
trigger1=!time
v=0
range=-8,4
[State 1007, Velset]
type=velset
trigger1=!time
x=var(0)

[State 1007, Veladd]
type=veladd
trigger1=1
y=0.4275

[State 1007, ChangeState]
type=ChangeState
trigger1=pos y > -vel y
value=1008
;-----------------------------------------------------------------------------------------
;Sparkle End
[Statedef 1008]
physics=N
anim=1008
velset=0,0

[State 1008, Assert]
type=trans
trigger1=1
trans=addalpha
alpha=256-16*time, 256
ignorehitpause=1

[State 1008, AngleDraw]
type=AngleDraw
trigger1=1
value=var(2)
scale=1.0-0.025*time,1.0-0.025*time
ignorehitpause=1

[State 1008, PosSet]
type=PosSet
trigger1=1
y=0
[State 1008, Assert]
type=assertspecial
trigger1= 1
flag=noshadow
ignorehitpause=1

[State 1008, End]
type=destroyself
trigger1=!animtime
;-----------------------------------------------------------------------------------------------------
;Tiger Crack FX
[StateDef 1105]
physics=N
ctrl=0
anim=1105
sprPriority=3

[State 1105, Swing Frame]
type=ChangeAnim
trigger1=root,animelemtime(4)=[0,1]
value=1105
elem=2
ignorehitpause=1

[State 1105, AssertSpecial]
type=AssertSpecial
trigger1=1
flag=noshadow
ignorehitpause=1
[State 1105, Assert]
type=trans
trigger1=1
trans=addalpha
alpha=256-16*time, 256
ignorehitpause=1

[State 1105, BindToRoot]
type=BindToRoot
trigger1=animelemtime(2)<0
pos=ceil(-15 * root,const(size.xScale)), ceil(32 * root,const(size.yScale))
ignorehitpause=1
[State 1105, BindToRoot]
type=BindToRoot
trigger1=animelemtime(2)>=0
pos=ceil(-10 * root,const(size.xScale)), ceil(10 * root,const(size.yScale))
ignorehitpause=1

[State 1105, End]
type=DestroySelf
trigger1=root,Movetype=H
trigger2=root,animelemtime(6)>=0
trigger3=root,stateno!=1100 && root,stateno!=1150
trigger4=root,time<=1
trigger5=!animtime
;-----------------------------------------------------------------------------------------------------
;Tiger Crack FX 2
[StateDef 1110]
physics=N
ctrl=0
anim=1110
sprPriority=3

[State 1110, Reset]
type=Varset
trigger1=!time 
var(1)=0
[State 1110, Reset]
type=Varadd
trigger1=root,animelemtime(10)>=0 
var(1)=1

[State 1110, AssertSpecial]
type=AssertSpecial
trigger1=1
flag=noshadow
ignorehitpause=1
[State 1110, Assert]
type=trans
trigger1=1
trans=addalpha
alpha=256-24*time, 256
ignorehitpause=1

[State 1110, AngleDraw]
type=AngleDraw
trigger1=var(1) 
value=-15*var(1)
[State 1110, BindToRoot]
type=BindToRoot
trigger1=1
pos=ceil(Ifelse(var(1),-22+var(1),-20) * root,const(size.xScale)), ceil(Ifelse(var(1),40,12) * root,const(size.yScale))
ignorehitpause=1

[State 1110, End]
type=DestroySelf
trigger1=root,Movetype=H
trigger2=root,stateno!=1100 && root,stateno!=1150
trigger3=root,time<=1
trigger4=!animtime
