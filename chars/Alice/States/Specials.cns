;------------------------------------------------------------------
;Southtown Variation
[Statedef 1000]
type=S
movetype=A
physics=N
anim=1000
ctrl=0
velset=0,0
poweradd=72 * !var(20)
sprpriority=1
facep2=1

[State 1000, VarSet]
type=VarSet
trigger1 =!AILevel&& !time
var(10)=Ifelse(command="x"||command="rlsx",0,Ifelse(command="y"||command="rlsy",1,2))
ignorehitpause=1
[State 1000, VarSet]
type=VarSet
trigger1 =AILevel&& !time
var(10)=Ifelse(p2bodydist x<40,0,Ifelse(p2bodydist x>=70,2,1))
ignorehitpause=1

[State 1000, reset]
type=VarSet
trigger1=animelemtime(3)<0
var(11)=0
ignorehitpause=1

[State 1000, anim]
type=ChangeAnim
Trigger1=!time
value=Ifelse(var(20),1003,1000+var(10))

[State 1000, PosSet]
type=PosSet
trigger1=!time
y=0

[State 1000, Voice]
type=PlaySnd
trigger1=animelem=3
value=s1000,0
volumescale=255
channel=0
[State 1000, Move Snd]
type=PlaySnd
trigger1=animelem=4
value=s1001,0
volumescale=50
channel=2

[State 1000, Dust Helper]
type=Helper
trigger1=animelem=4
helperType=Normal
stateNo=8103
ID=8100
name="Dash Dust"
posType=P1
pos=-10,0
pauseMoveTime=255
superMoveTime=255
ownPal=1

[State 1000, SouthTown Var FX]
type=Helper
trigger1=animelemtime(4)>=0 && animelemtime(5)<0
trigger1=time%2
helperType=Normal
stateNo=1005
ID=1005
name="SouthTownVarFX"
posType=P1
pos=ceil(0 * const(size.xScale)),ceil(0 * const(size.yScale))
size.xscale=const(size.xScale)
size.yscale=const(size.yScale)
ownPal=1
ignorehitpause=1

[State 1000, Skid Dust]
type=Explod
trigger1=animelem=5
anim=8104
sprPriority=3
posType=P1
pos=18,0
scale=0.5,0.5
ownpal=1
[State 1000, Skid Snd]
type=PlaySnd
trigger1=animelem=5
value=101,0
channel=5

[State 1000, Vel]
type=Velset
trigger1=animelem=4
x=8+var(10)
[State 1000, VelMul]
type=VelMul
trigger1=animelemtime(4)>=8+4*var(10)
x=0.8725
[State 1000, Vel]
type=Velset
trigger1=animelem=6
x=0

[State 1000, VarSet]
type=VarSet
triggerall=movecontact=1 && !var(11)
trigger1=!AILevel && (animelemtime(4)>=1 && animelemtime(9)<0) 
trigger1=(command="x"||command="y"||command="z") && (command="holdfwd")
trigger2=AILevel && (animelemtime(4)>=1 && animelemtime(9)<0) 
trigger2=random<500
var(11)=1
ignorehitpause=1
[State 1000, VarSet]
type=VarSet
triggerall=movecontact=1 && !var(11)
trigger1=!AILevel && (animelemtime(4)>=1 && animelemtime(9)<0) 
trigger1=(command="a"||command="b"||command="c") && (command="holdfwd")
trigger2=AILevel && (animelemtime(4)>=1 && animelemtime(9)<0) 
trigger2=random<500
var(11)=2
ignorehitpause=1

[State 1000, Hit]
type=HitDef
trigger1=!var(16) && (var(15)<2 || var(20))
trigger1=!time
attr=S, SA
damage=42+7*var(10), 7
priority=4, hit
animtype=Hard
getpower=ifelse(!var(13),144,72) * !var(20), 36 * !var(20)
givepower=36,36
guardflag=MA
hitflag=MAF
hitsound=S2,2
guardsound=S130,0
pauseTime=ifElse(var(20), 4, 12), ifElse(var(20), 8, 16)
guard.pauseTime=ifElse(var(20), 6, 12), ifElse(var(20), 6, 12)
sparkNo=-1 + 0 * (var(33) :=8013)
guard.sparkNo=-1 + 0 * (var(34) :=8001)
sparkXY=-10 + 0 * (var(35) :=100), var(36) :=-71
air.animtype=Back
fall.animtype=Back
ground.type=High
ground.slidetime=16
ground.hittime =16
guard.hittime = (16) - 6
ground.velocity=Ifelse(var(20),-2,-4),0
air.velocity=Ifelse(var(20),-2,-4),-6
guard.velocity=Ifelse(var(20),-5,-10)
airguard.velocity =Ifelse(var(20),-4,-8), -3
airguard.ctrlTime=16
ground.cornerPush.velOff=0
guard.cornerPush.velOff=0
air.cornerPush.velOff=0
yAccel = (0.5 + (ComboCount * 0.01))
fall=0
air.fall=1
fall.recover=0
forcestand=1
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd=-255,-255,-255,48
envshake.time=14
envshake.ampl=4
envShake.freq=120

[State 1000, Sparkles]
type=helper
trigger1=movehit && numtarget && !numhelper(1006)
trigger1=!(target, time) && (target, movetype=H)
trigger1=(enemynear,stateno=[5000,5050])
helpertype=normal
stateno=1006
ID=1006
name="Sparkles"
postype=p2
pos=0,-70
size.xscale=0.25
size.yscale=0.25
ownpal=1
ignorehitpause=1

[State 1000, StateTypeSet: Idle]
type=StateTypeSet
trigger1=AnimElemTime(5) =0
movetype=I

[State 1000, Change]
type=ChangeState
triggerall=var(11)
trigger1=animelemtime(4)>2 && animelemtime(9)<0
value=1000+(10*var(11))
[State 1000, End]
type=ChangeState
trigger1=!AnimTime
value=0
ctrl=1
