;KIKOSHO>=
[Statedef 1000]
type = S
movetype = A
physics = S
anim = 1000
ctrl = 0
velset = 0,0
poweradd = 70 * !var(20)
sprpriority = 2
facep2 = 1

[State 1000, Position]
type = PosSet
trigger1 = !time
y = 0

[State 1000, Width]
type = Width
trigger1 = AnimElemTime(6) = 0
value = 45, 0

[State 1000, Button Detect]
type = VarSet
trigger1 = !Time
var(10) = ifElse((helper(10371), var(0)) || (helper(10371), var(7)), 0, ifElse((helper(10371), var(1)) || (helper(10371), var(8)), 1, 2))

[State 1000, ChangeAnim]
type = ChangeAnim
trigger1 = !Time
value = ifelse(var(10)=2, 1020, ifelse(var(10)=1, 1010, 1000))

[State 1000, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 0,4
channel = 0

[State 1000, Swing Snd]
type = PlaySnd
trigger1 = Animelem = 5
value = 1000, 0

[State 1000, Kikosho FX]
type = Explod
trigger1 = AnimElem = 6
anim = 1006
ID = 1006
sprPriority = 3
posType = p1
pos = 89, -50
scale = .5,.5 ;IfElse(var(10)=2, 0.55, ifElse(var(10), 0.5, 0.45)), IfElse(var(10)=2, 0.55, ifElse(var(10), 0.5, 0.45))
pauseMoveTime = -1
superMoveTime = -1
ownPal = 1

[State 1000, Kikosho]
type = Helper
trigger1 = AnimElem = 6
helpertype = Normal
stateno = 1005
ID = 1005
name = "Kikosho"
pos = 89,-50
postype = P1
size.xscale = .5
size.yscale = .5
ownpal = 1

[State 1000, Hit]
type = HitDef
trigger1 = !var(16) && var(15) < 1
trigger1 = AnimElem = 6
attr = A, SA
damage = ceil(ifElse(fvar(11) * ifElse(var(10) = 2, 63, ifElse(var(10), 56, 49)) < 7, 7, fvar(11) * ifElse(var(10) = 2, 63, ifElse(var(10), 56, 49)))), 7
priority = 4, hit
animtype = Hard
getpower = 70 * !var(20), 30 * !var(20)
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,6
guardsound = S130,0
pausetime = 0,12
guard.pausetime = 0,12
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 180), var(36) := -50
air.animtype = Back
fall.animtype = Back
ground.type = Low
air.type = Low
ground.slidetime = 18
ground.hittime = 18
guard.hittime = (18) - 6
air.hitTime = 60
airGuard.ctrlTime = 16
ground.velocity = -8.25,ifelse(var(10)=2,-4.15,0)
air.velocity = -4.35, -6.15
guard.velocity = -8.25
airguard.velocity = -6, -4
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .58
fall = ifelse(var(10)=2,1,0)
air.fall = 1
fall.recover = 0
forcestand = 0
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 14
envshake.ampl = 4
envShake.freq = 120

[State 1000, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(9) >= 0
movetype = I

[State 1000, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

