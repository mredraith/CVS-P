;***************************************************************************;
;***************************************************************************;
; CVS Vega (Claw) POTS/Infinite by Falcon Rapper
;***************************************************************************;
;***************************************************************************;
; "Porque o guerreiro de f nunca gela" by: Racionais mc's
;***************************************************************************;
;***************************************************************************;

;------------------------------------------------------------------
; Flying Barcelona Special (Start)
[Statedef 3000]
type = S
movetype = I
physics = S
ctrl = 0
velset = 0,0

[State 3000, Super Cancel Flag]
type=VarSet
trigger1=!Time
var(21)=(PrevStateNo=[1000,2999]) && var(6)
[State 3000, Hyper Cancel Flag]
type=VarSet
trigger1=!Time
var(22)=((prevstateno=[3000,4999]) && var(7)) || var(20)
[State 3000, Super Cancel Flash]
type=PalFX
trigger1=var(21) || var(22)
trigger1=!(Time % 2) && Time <=4
time=1
add=255,255,255
ignoreHitPause=1

[State 1100,varset]
type = varset
trigger1 = Time=0 && !fvar(38)
var(2) = ifelse(command="holdfwd",1,ifelse(command="holdback",-1,ifelse((BackEdgeBodyDist-FrontEdgeBodyDist)>=0,1,-1)))

[State 1100,varset]
type = varset
trigger1 = Time=0 && fvar(38)
var(2) = ifelse((FrontEdgeBodyDist <70 && random <400),1,-1)

[State 1100,varset]
type = ScreenBound
trigger1 = var(2)=1&&Anim=1100 && time<26;FrontEdgebodydistłȂAP2bodydist Ŕf
value = 0
movecamera = 1,0

[State 1100,varset]
type = ScreenBound
trigger1 = var(2)=1&&Anim=1100&&time>=26 && time<28 && Vel X>=6
value = 1

[State 1100,ChangeAnim]
type = ChangeAnim
trigger1 = time=0
value = 1100+(var(2)=-1)*1

[State 1100,PlaySnd]
type = PlaySnd
trigger1 = time=0
value = 1100,0
channel = 1

[State 1100,StatetypeSet]
type = StatetypeSet
trigger1 = (Anim=1100 || Anim=1101) && AnimElem=2,=0
statetype = A
physics = N

[State 1100,VelSet_back]
type = VelSet
triggerall = (Anim=1100 || Anim=1101) && AnimElem=2,=0
trigger1 = var(2)=-1
x = -9;-8.7+(4*(200-BackEdgeBodyDist)/86)
y = -8.0;-7.8;-9.6

[State 1100,VelSet_fwd]
type = VelSet
triggerall = (Anim=1100 || Anim=1101) && AnimElem=2,=0
trigger1 = var(2)=1
x = 9;8.7-ifelse(FrontEdgeBodyDist <=200,(4*(200-FrontEdgeBodyDist)/86),0)
y = -8.0;-7.8;-9.6

[State 1100,VelMul]
type = VelMul
trigger1 = (Anim=1100 || Anim=1101) && AnimElem=2,=0&&var(2)=-1
x = 1.5;+ifelse(backedgebodydist>200,.25,ifelse(Backedgebodydist>120,((backedgebodydist-80)/60)*.12,0))

[State 1100,VelMul]
type = VelMul
trigger1 = (Anim=1100 || Anim=1101) && AnimElem=2,=0&&var(2)=1
x = 1.5;+ifelse(frontedgebodydist>200,.25,ifelse((frontedgebodydist>120&&var(2)=-1),((frontedgebodydist-80)/60)*.12,0))

[State 1100,VelAdd]
type = VelAdd
trigger1 = (Anim=1100 || Anim=1101) && AnimElemTime(2)>=0
y = .4

[State 40, Snd]
type = playsnd
trigger1 = AnimElem=2
value = 41, 0
[State 40, Dust]
type = helper
trigger1 = AnimElem=2
helpertype = normal
stateno = 8100
ID = 8100
name = "Jump Dust"
postype = p1
ownpal = 1

[State 1100,varset]
type = null;ScreenBound
trigger1 = 1
value = 0
movecamera = 0,1

[State 1100,ChangeState]
type = ChangeState
trigger1 = Anim=1100
trigger1 = FrontEdgeDist <= 15 && Pos Y<-25
trigger2 = Anim=1101
trigger2 = BackEdgeDist <= 15 && Pos Y<-25
value = 3001

[State 1100,ChangeState]
type = ChangeState
trigger1 = Time > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 1104

;------------------------------------------------------------------
; Flying Barcelona Special (Wall)
[Statedef 3001]
type = A
movetype =I
physics = N
velset = 0,0
poweradd = -1000

[State 1120,ChangeAnim]
type = ChangeAnim
trigger1 = Time=0
value = 3000

[State 3020,NotHitBy]
type = NotHitBy
trigger1 = time=0
value = SCA
time=55

[State 3000, No Corner Push]
type=VarSet
trigger1=time=3
fvar(5)=0
[State 3000, Unguardable]
type=VarSet
trigger1=time=3 && NumEnemy
trigger1=(EnemyNear, StateNo !=[120,155])
var(17)=47
[State 3000, Super Cancel Flag]
type=VarSet
trigger1=!Time
var(21)=(PrevStateNo=[1000,2999]) && var(6)
[State 3000, Hyper Cancel Flag]
type=VarSet
trigger1=!Time
var(22)=((prevstateno=[3000,4999]) && var(7)) || var(20)
[State 3000, Super Cancel Flash]
type=PalFX
trigger1=var(21) || var(22)
trigger1=!(Time % 2) && Time <=12
time=1
add=255,255,255
ignoreHitPause=1
[State 3000, Super Cancel Juggle Reset]
type=VarSet
trigger1=!Time
trigger1=var(21) || var(22)
var(15)=0
ignoreHitPause=1

[State 3000, SuperPause FX]
type=Helper
trigger1=time=3
helperType=Normal
stateNo=8500
ID=8500
name="Superpause FX"
posType=P1
pos = -34,-98
superMoveTime=255
size.xScale=1
size.yScale=1
ownPal=1
[State 3000, SuperPause]
type=SuperPause
trigger1=time=3
time=47
moveTime=47
p2DefMul=1
unHittable=1
anim=-1
sound=s8500,0
darken=0
poweradd=0

[State 1103,StopSnd]
type = StopSnd
trigger1 = Time=0
channel = 0

[State 1125,Turn]
type = Turn
trigger1 = Time = 0 && Var(2)=-1

[State 1103,PosAdd]
type = PosAdd
trigger1 = Time <= 10
x = 40

[State 61, Jump Dust]
type = Explod
trigger1 = !AnimTime
anim = 8101
ID = 8101
sprPriority = 3
posType = P1
pos = 23,-44
ownPal = 1
scale = 0.5,0.5
pauseMoveTime = -1
superMoveTime = -1

[State 40, Snd]
type = playsnd
trigger1 = !AnimTime
value = 41, 0

[State 1100,Exit]
type = ChangeState
trigger1 = AnimTime=0
value = 3002

;------------------------------------------------------------------
; Flying Barcelona Special (Wall Jump)
[Statedef 3002]
type = A
movetype = I
physics = N
anim = 1103
velset = 0,0

[State 1103,Turn]
type = Turn
trigger1 = Time=0 && !(enemynear,backedgebodydist <=0 && var(2)=1)

[State 1103,PlaySnd]
type = PlaySnd
trigger1 = Time=0
value = 1000,0
channel = 1

[State 1100,varset]
type = ScreenBound
trigger1 = time=0
value = 0
movecamera = 1,0

[State 1103,VelSet]
type = VelSet
trigger1 = Time=0
x= ifelse((enemynear,backedgebodydist <=0 && var(2)=1),-1.5,ifelse(P2bodydist X<20,0,ifelse(Abs((P2Dist X -70) / 43)<1.5,1.5,ifelse(Abs((P2Dist X -70) / 43)<2.5,2.5,Abs((P2Dist X -70) / 43)))))
y = -11.5-(Pos Y>-35)*.5;-10.25;-8.5

[State 1103,VelSet]
type = VarSet
trigger1 = Time=0
fvar(15)=Vel X

[State 1103]
type = VelAdd
trigger1 = Time>=0
y = .68;.6;.55

[State 1450]
type = VelSet
trigger1 = command!="holdfwd" && command!="holdback"
x = fvar(15)

[State 1103,VelAdd]
type = VelSet
trigger1 = command="holdfwd" || command="holdback"
x = fvar(15)+ifelse(command="holdfwd",4.25,-4.25)

[State 1130,ChangeState]
type = ChangeState
triggerall = Vel Y > 0 && AIlevel
trigger1 = (var(3)=[0,1])
value = 3100

[State 1103,Attack]
type = ChangeState
triggerall = Vel Y > 0 && !AIlevel
trigger1 = command="pp"
value = 3100

[State 1103,Attack]
type = ChangeState
triggerall = Vel Y > 0 && !AIlevel
trigger1 = (command="x" || command="y" || command="z")
value = 3010

[State 1103,Exit]
type = ChangeState
trigger1 = pos y > -vel y
value = 1104
;------------------------------------------------------------------
; Flying Barcelona Special (Hit)
[Statedef 3010]
type = A
movetype = A
physics = N
ctrl = 0

[State 3000,varset]
type = varset
trigger1 = !Time
var(10) = 1

[State 3010, Snd]
type = playsnd
trigger1 = !Time
value = 1, 12

[State 1350,ChangeAnim]
type = ChangeAnim
trigger1 = Time=0
value = ifelse(var(10)=1,3010,3020)

[State 1450]
type = VelSet
trigger1 = command!="holdfwd" && command!="holdback"
x = fvar(15)

[State 1103,VelAdd]
type = VelSet
trigger1 = command="holdfwd" || command="holdback"
x = fvar(15)+ifelse(command="holdfwd",4.25,-4.25)

[State 1350,VelAdd]
type = VelAdd
trigger1 = 1
y = .35

[State 1350,Hitdef1]
type = HitDef
triggerall = !var(16) && (var(15) < 3 || var(20))
trigger1= Animelem=2 || Animelem=3 || Animelem=4
attr = A, HA
damage=ifElse(numtarget(3000), 10, 150+20*var(10)),4
id = 3000
animtype = Hard
guardflag = H
hitflag = MAF
pausetime = 7, 7
sparkNo=-1 + 0 * (var(33) := 8024)
guard.sparkNo=-1 + 0 * (var(34) := 8001)
sparkXY=-10 + 0 * (var(35) := 120), var(36) := -31
hitsound=S3,2
guardsound=s130, 0
ground.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = (18) - 6
ground.velocity = ifElse(P2Dist X < 0,3.5,-3.5),-6.0
guard.velocity = -11.0
air.velocity = ifElse(P2Dist X < 0,3.5,-3.5),-6.0
yaccel = .5
fall = 1
air.fall = 1
fall.recover = 0
getpower = 0*var(5),0*var(5)
givepower = 2*var(6),2*var(6)
forcestand = 1
priority  = 7, Hit
palFX.time=10 * var(9)
palFX.add=255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time=10
envshake.ampl=Ifelse(random<=500,-3,3)

[State 1350,ChangeAnim]
type = ChangeAnim
trigger1 = animTime=0
value = 3050

[State 1350,Hitdef_finish]
type = HitDef
triggerall = !var(16) && (var(15) < 3 || var(20))
trigger1 = Anim=3050 && AnimElem=1
attr = A, HA
damage=ifElse(numtarget(3000), 10, 150+20*var(10)),4
id = 3000
animtype = Hard
guardflag = H
hitflag = MAF
pausetime = 7, 7
sparkNo=-1 + 0 * (var(33) := 8024)
guard.sparkNo=-1 + 0 * (var(34) := 8001)
sparkXY=-10 + 0 * (var(35) := 120), var(36) := -31
hitsound=S3,2
guardsound=s130, 0
ground.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = (18) - 6
ground.velocity = ifElse(P2Dist X < 0,3.5,-3.5),-6.0
guard.velocity = -11.0
air.velocity = ifElse(P2Dist X < 0,3.5,-3.5),-6.0
yaccel = .5
fall = 1
air.fall = 1
fall.recover = 0
getpower = 0*var(5),0*var(5)
givepower = 2*var(6),2*var(6)
forcestand = 1
priority  = 7, Hit
palFX.time=10 * var(9)
palFX.add=255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time=10
envshake.ampl=Ifelse(random<=500,-3,3)

[State 8050, Blood]
type=Helper
trigger1 = HitPauseTime && !var(47)
trigger1 = MoveHit = 1 && NumTarget
helperType=Normal
stateNo=8040
ID=8042
name="Blood"
posType = P1
pos = ceil(P2Dist x), var(36)
size.xScale=.5
size.yScale=.5
facing = ifElse((Target, Facing = Facing), -1, 1)
ownPal = 1
ignoreHitPause = 1

[State 1350,Exit]
type = ChangeState
trigger1 = pos y > -vel y
value = 1104

