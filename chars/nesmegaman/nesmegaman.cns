trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, Air Tornado]
type = VarSet
trigger1 = Time = 0
v = 2
value = 112

[State 5900, Flash Stop]
type = VarSet
trigger1 = Time = 0
v = 6
value = 112

[State 5900, Metal Blade]
type = VarSet
trigger1 = Time = 0
v = 7
value = 112

[State 5900, 3] ;Intro for round 1
