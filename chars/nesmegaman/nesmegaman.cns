;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, Custom 1]
type = ChangeState
triggerall = PrevStateNo != 1
trigger1 = Ctrl
trigger2 = PrevStateNo != [190,191]
trigger2 = PrevStateNo != 5900
value = 1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand - Custom
[Statedef 1]
type = S
physics = S
sprpriority = 0

[State 1, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 1, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 1, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 1, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 1, Custom 1]
type = CtrlSet
trigger1 = 1
value = 0

[State 1, Custom 2] ;Win Game go to stand state
type = ChangeState
trigger1 = RoundState = 3
value = 0
ctrl = 1

[State 1, Custom 3]
type = Turn
trigger1 = P2Dist X < 0
trigger1 = P2Name != "M-NES Game 1"

