trigger1 = Projguardedtime(3006) >= 0 && Projguardedtime(3006) <= 1
stateno = 8001
pos = 0,-40
postype = p2
facing = -1
vfacing = 1
bindtime = 1
removetime = -2
sprpriority = 9
supermove = 1
pausemove = 1



[State , HitDef]
type		= HitDef
;triggerall	= var(7) >0 || MoveContact || MoveReversed
trigger1	= AnimElem = 8
trigger2	= AnimElem = 12
trigger3	= AnimElem = 16
trigger4	= AnimElem = 20
trigger5	= AnimElem = 24
trigger6	= AnimElem = 28
trigger7	= AnimElem = 32
trigger8	= AnimElem = 36
trigger9	= AnimElem = 40
trigger10	= AnimElem = 44
trigger11	= AnimElem = 48
trigger12	= AnimElem = 52
trigger13	= AnimElem = 56
trigger14	= AnimElem = 60
trigger15	= AnimElem = 64
trigger16	= AnimElem = 68
attr		= A, HA
damage		= 3,1  ;10,1
animtype	= Hard
air.animtype	= Back
ground.type	= High
guardflag	= M
hitflag		= MAF
priority	= 1, Hit
p2facing	= 1
pausetime	= 1,6 + floor(7-AnimElemNo(0)/10) + (var(42)>0)*4
guard.pausetime	= 1,1
ground.slidetime= 25
ground.hittime	= 25
guard.hittime = (25) - 6
ground.velocity	= 2*(p2Dist x > 50)-2*(p2Dist x < -50),0
guard.velocity	= 0
air.velocity	= 1-2*(p2Dist x < 0),2*(p2Dist y < -80)-2*(p2Dist y > -30)
getpower	= 0,0
givepower	= 8,8
ground.cornerpush.veloff= 0
guard.cornerpush.veloff	= 0
air.cornerpush.veloff	= 0
yaccel		= .5
air.fall		= 1
air.fall.recover	= 0
air.fall.recovertime	= 25
;FX POTS
sparkNo = -1 + 0 * (var(33) := 8014)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 68), var(36) := -40
hitsound = s-1, (var(31) := 5)
guardsound = s-1, (var(32) := 0)
getpower = 0,0
givepower = 35, 35
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 14
envshake.ampl = 4
envShake.freq = 120



