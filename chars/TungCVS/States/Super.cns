;======================BY ZMugens======================================================
;Senpuu Gouken
[Statedef 3000]
type		= U
movetype	= A
physics		= N
ctrl		= 0
velset		= 0,0
sprpriority	= 1
juggle		= 0
facep2		= 1
anim		= 3000

[State 1000, VarSet]
type = VarSet
trigger1 =!AILevel&& time =0
var(10) = ifelse((command="z"|command="rlsz"),2,ifelse((command="y"|command="rlsy"),1,0))
ignorehitpause = 1

[State 1000, Anim]
type = ChangeAnim
Trigger1 = Time = 0
value = ifelse(!var(10),3000,ifelse(var(10)=1,3000,3000))
ignorehitpause = 1

[State 1010, Velocity]
type = VelSet
trigger1 = animelem = 4
x = ifElse(var(10) = 2, 3.2, ifElse(var(10) = 1, 1.5, 0))
y = 0

[State 3000, Super Cancel Flag]
type = VarSet
trigger1 = !Time
var(21) = ((PrevStateNo = [1000,2999]) && var(6)) || var(20)

[State 3000, Hyper Cancel Flag]
type = VarSet
trigger1 = !Time
var(22) = (PrevStateNo = [3000,4999]) && var(7)

[State 3000, Custom Combo Reset]
type = PalFX
trigger1 = !Time
trigger1 = !(var(20) := 0)
time = 1

[State 3000, Super Cancel Flash]
type = PalFX
trigger1 = var(21) || var(22)
trigger1 = !(Time % 2) && Time <= 12
time = 1
add = 255,255,255
ignoreHitPause = 1

[State 3000, Super Cancel Juggle Reset]
type = VarSet
trigger1 = !Time
trigger1 = var(21) || var(22)
var(15) = 0
ignoreHitPause = 1

[State 3000, SuperPause FX]
type = Helper
trigger1 = Time = 0
stateNo = 8500
ID = 8500
name = "Superpause FX"
posType = P1
pos = 5,-60
superMoveTime = 255
size.xScale = 1
size.yScale = 1
ownPal = 1

[State 3000, SuperPause Sound]
type = PlaySnd
trigger1 = Time = 0
value = 8500, 0

[State 3000, SuperPause]
type = SuperPause
trigger1 = Time = 0
time = 28
moveTime = 28
p2DefMul = 1
unHittable = 1
anim = -1
sound = -1
darken = 0
poweradd = -1000

[State , ChangeState]
type		= ChangeAnim
trigger1	= time < 20
value		= anim
elem		= 1


[State , Helper]
type		= Helper
trigger1	= Time = 0
trigger1	= NumHelper(3005) = 0
helpertype	= normal
name		= "Effect_Helper"
ID		= 3005
stateno		= 3005
postype		= p1
pos		= 0,0
supermovetime	= 9999999999999999
pausemovetime	= 9999999999999999
ignorehitpause	= 1
persistent	= 0


[State , NotHitBy]
type		= NotHitBy
trigger1	= time = 0  ;AnimElemTime(5) < 0
value		= SCA
time		= 40


[State , Gravity]
type		= Gravity
trigger1	= AnimElemNo(0) >= 84
trigger1	= Pos Y < 0

[State , Velset]
type		= VelSet
trigger1	= AnimElemNo(0) >= 84
trigger1	= Pos Y >= 0
x		= 0
y		= 0

[State , Velset]
type		= PosSet
trigger1	= AnimElemNo(0) >= 84
trigger1	= Pos Y > 0
y		= 0

[State , RemoveExplod]
type		= RemoveExplod
trigger1	= time = 0
id		= 1411
[State , RemoveExplod]
type		= RemoveExplod
trigger1	= time = 0
id		= 1412


[State , StateTypeSet - State]
type		= StateTypeSet
trigger1	= AnimElem = 3
statetype	= A

[State , StateTypeSet - Move]
type		= StateTypeSet
trigger1	= AnimElem = 82
movetype	= I

[State , Width]
type		= Width
trigger1	= 1
edge		= 0,0

[State , VarSet]
type		= VarSet
trigger1	= time = 1
var(9)		= 2

[State , VarSet]
type		= VarSet
trigger1	= animelem = 83
trigger1	= helper(9800),NumExplod(30060) != 0
var(9)		= 20


[State , PlaySnd - Voice]
type		= PlaySnd
trigger1	= animelem = 2
value		= S3000,0
channel		= 0
[State , PlaySnd - Voice]
type		= PlaySnd
trigger1	= animelem = 34
value		= S3000,1
channel		= 0
[State , PlaySnd - SE]
type		= PlaySnd
trigger1	= AnimElem = 12
value		= S20,1
ignorehitpause	= 1



[State , Projectile]
type		= Projectile
trigger1	= AnimElem = 6
