projsprpriority	= 2
projedgebound	= 20
projstagebound	= 20
projheightbound	= -240, 1
offset		= 0, 0
postype		= p1
supermovetime	= 0
pausemovetime	= 0
; HitDef part of projectile info
attr		= A, HA
damage		= 7,5  ;10,5
animtype	= Hard
air.animtype	= Back
ground.type	= High
guardflag	= M
hitflag		= MAF
priority	= 4, Hit
p2facing	= 1
sparkno		= s902
sparkxy		= Floor(P2Dist X) , -70
hitsound	= s2, 5
guardsound	= s130, 0
guard.sparkno	= s931
pausetime	= 1,6 + (var(42)>0)*4
guard.pausetime	= 1,1
ground.slidetime= 25
ground.hittime	= 25
ground.velocity	= 2*(p2Dist x > 50)-2*(p2Dist x < -50),0
guard.velocity	= 0
air.velocity	= 1-2*(p2Dist x < 0),2*(p2Dist y < -80)-2*(p2Dist y > -30)
getpower	= 0,0
givepower	= 8,8
ground.cornerpush.veloff= 0
guard.cornerpush.veloff	= 0
air.cornerpush.veloff	= 0
yaccel		= .5
air.fall		= 1
air.fall.recover	= 0
air.fall.recovertime	= 25


[State 1000, Explod]
type = Helper
trigger1 = Projhittime(3006) >= 0 && Projhittime(3006) <= 1
stateno = 8014
pos = 0,-40
postype = p2
facing = -1
vfacing = 1
bindtime = 1
removetime = -2
sprpriority = 9
supermove = 1
pausemove = 1


[State 1000, Explod]
