value		= ,AP

[State , Helper]
type		= Helper
trigger1	= Time = 0
helpertype	= normal
name		= "Effect_Helper"
ID		= 3501
stateno		= 3501
postype		= p1
pos		= 0,0
supermovetime	= 9999999999999999
pausemovetime	= 9999999999999999


[State , RemoveExplod]
type		= RemoveExplod
trigger1	= time = 0
id		= 1411
[State , RemoveExplod]
type		= RemoveExplod
trigger1	= time = 0
id		= 1412

[State , VarSet]
type		= VarSet
trigger1	= time = 1
var(9)		= 13

[State , VarSet]
type		= VarSet
trigger1	= AnimElemTime(17) >= 0 && AnimElemTime(19) < 0
var(20)		= (3510 + AnimElemNo(0) -17) * -1
[State , VarSet]
type		= VarSet
trigger1	= AnimElemTime(19) >= 0 && AnimElemTime(40) < 0
var(20)		= (3512 + (AnimElemNo(0)-19)%3) * -1
[State , VarSet]
type		= VarSet
trigger1	= AnimElemTime(40) >= 0 && AnimElemTime(42) < 0
var(20)		= (3515 + AnimElemNo(0) - 40) * -1


[State , PlaySnd - Voice]
type		= PlaySnd
trigger1	= animelem = 5
value		= S3010,0
channel		= 0
[State , PlaySnd - Voice]
type		= PlaySnd
trigger1	= animelem = 18
value		= S3010,1
channel		= 0
[State , PlaySnd - SE]
type		= PlaySnd
trigger1	= AnimElem = 5
value		= S20,1
ignorehitpause	= 1


[State , Projectile]
type		= Projectile
trigger1	= AnimElem = 17
trigger2	= AnimElem = 18
trigger3	= AnimElem = 19
trigger4	= AnimElem = 20
trigger5	= AnimElem = 21
trigger6	= AnimElem = 22
trigger7	= AnimElem = 23
trigger8	= AnimElem = 24
trigger9	= AnimElem = 25
trigger10	= AnimElem = 26
trigger11	= AnimElem = 27
trigger12	= AnimElem = 28
trigger13	= AnimElem = 29
trigger14	= AnimElem = 30
trigger15	= AnimElem = 31
trigger16	= AnimElem = 32
trigger17	= AnimElem = 33
trigger18	= AnimElem = 34
trigger19	= AnimElem = 35
trigger20	= AnimElem = 36
trigger21	= AnimElem = 37
trigger22	= AnimElem = 38
trigger23	= AnimElem = 39
trigger24	= AnimElem = 40
trigger25	= AnimElem = 41
projID		= 3500
projanim	= var(20) * -1
projscale	= 1,1
projremove	= 0
projremovetime	= 2
velocity	= 0, 0
remvelocity	= 0, 0
accel		= 0, 0
velmul		= 1, 1
projhits	= 1
projpriority	= 7
projsprpriority	= 5
projedgebound	= 20
projstagebound	= 20
projheightbound	= -240, 1
offset		= -20,-20 ;0,0
postype		= p1
supermovetime	= 0
pausemovetime	= 0
; HitDef part of projectile info
attr		= S, SP
hitflag		= MAFD
guardflag	= M
animtype	= diagup
air.animtype	= diagup
ground.type	= High
priority	= 1, Hit
damage		= 23,7
sparkno		= s1
guard.sparkno	= s1
;sparkxy	= 0, 0
sparkxy		= Floor(P2Dist X) , Floor((P2Dist Y)-40)
hitsound	= s2, 6
guardsound	= s130, 1
pausetime	= 0,9 + (var(42)>0)*4
guard.pausetime	= 0,9
ground.slidetime= 18
ground.hittime	= 18
ground.velocity	= -4,-5
guard.velocity	= -4.5
air.velocity	= -4,-5
air.juggle	= 0
;ground.cornerpush.veloff= 0
;guard.cornerpush.veloff	= 0
;air.cornerpush.veloff	= 0
yaccel		= 0.5
fall		= 1
fall.recover = 0
guard.dist	= 600

[State 1000, Explod]
type = Helper
trigger1 = Projhittime(3500) >= 0 && Projhittime(3500) <= 1
stateno = 8014
pos = 0,-40
postype = p2
facing = -1
vfacing = 1
bindtime = 1
removetime = -2
sprpriority = -9
supermove = 1
pausemove = 1


[State 1000, Explod]
type = Helper
trigger1 = Projguardedtime(3500) >= 0 && Projguardedtime(3500) <= 1
stateno = 8001
pos = 0,-40
postype = p2
facing = -1
vfacing = 1
bindtime = 1
removetime = -2
sprpriority = -9
supermove = 1
pausemove = 1



[State , VelSet]
type		= VelSet
trigger1	= ProjContactTime(3500) = 1
trigger1	= FrontEdgeBodyDist <= 100
x		= -4

;Chou Shou Ha Helper
[Statedef 3501]
type		= S
ctrl		= 0
anim		= 3501
velset		= 0,0
sprpriority	= 3

[State , BindToParent]
type		= BindToParent
trigger1	= 1
time		= 1
facing		= 0
pos		= 0, 0
ignorehitpause	= 1

[State , parentVarSet]
type		= VarSet
trigger1	= AnimElemTime(41) = 0
var(4)		= 0
ignorehitpause	= 1

[State , VarAdd]
type		= Varadd
trigger1	= AnimElemTime(41) > 0
var(4)		= 2
ignorehitpause	= 1

[State , ChangeAnim]
type		= ChangeAnim
trigger1	= AnimElemTime(41) < 0
value		= Anim
elem		= Parent,AnimElemNo(0)
ignorehitpause	= 1

[State , Trans]
type		= Trans
trigger1	= AnimElemTime(41) >= 0
trans		= addalpha
alpha		= 256-var(4)*5,var(4)*5
ignorehitpause	= 1

[State , DestroySelf]
type		= DestroySelf
trigger1	= AnimTime = 0
trigger2	= Parent,StateNo != 3500

