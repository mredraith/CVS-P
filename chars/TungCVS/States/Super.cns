[Statedef 3005]
type		= S
ctrl		= 0
anim		= 3005
velset		= 0,0
sprpriority	= 5

[State , BindToParent]
type		= BindToParent
trigger1	= 1
time		= 1
facing		= 0
pos		= 0, 0
ignorehitpause	= 1

[State , VarSet]
type		= VarSet
trigger1	= time = 0
var(4)		= 128
ignorehitpause	= 1

[State , VarAdd]
type		= Varadd
trigger1	= var(4) = [50,250]
var(4)		= (AnimElemTime(74) < 0)*2 - (AnimElemTime(74) > 0)*2
ignorehitpause	= 1

[State , ChangeAnim]
type		= ChangeAnim
trigger1	= Parent,StateNo = [3000,3019]
value		= Anim
elem		= Parent,AnimElemNo(0)
ignorehitpause	= 1

[State , Trans]
type		= Trans
trigger1	= var(4) = [50,250]
trigger1	= Parent,StateNo = [3000,3019]
trans		= addalpha
alpha		= var(4),256-var(4)
ignorehitpause	= 1

[State , DestroySelf]
type		= DestroySelf
trigger1	= AnimTime = 0
trigger2	= Parent,StateNo != [3000,3019]

