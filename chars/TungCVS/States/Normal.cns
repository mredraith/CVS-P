trigger1 = AnimElem = 1
value = 0,2
channel = 0

[State 220, PosAdd]
type=PosAdd
trigger1 =animelem=2,>=0&&animelem=3,<0
x=6

[State 221, Muteki: Z-Counter]
type=Nothitby
trigger1=PrevStateNo=750 && AnimElemTime(4)<0
time=1
value=SCA

[State 221, HitDef]
type=HitDef
trigger1 = !var(16) && (var(15)<1 || var(20))
trigger1=AnimElem=12 && PrevStateNo != 750
attr=S,NA 
hitflag=MAF 
guardflag=M 
animtype=Hard 
priority=4, Hit 
damage = Ifelse(var(55),75,96), 0
