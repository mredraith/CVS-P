; Dodge Strong Punch/Z-Counter Punch
[Statedef 221]
type =S
movetype= A
physics=S
poweradd= ifElse(PrevStateNo=750, 0, 30 * !var(20))
ctrl=0
velset=0,0
anim=221
sprpriority=2
facep2=1

[State 221, Swing Snd]
