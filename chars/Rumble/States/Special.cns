;========================<Fire Ball>=======================
; Fire Ball
[Statedef 1000]
type = S
movetype = A
physics = N
anim = 1000
ctrl = 0
velset = 0,0
poweradd = 70 * !var(20)
sprpriority = 2
facep2 = 1

[State 4101, AngleDraw]
type = AngleDraw
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(3) <= 18
value = 1
scale = 0.94, 0.94

[State 1000, Strength]
type = varset
trigger1 = !time && !AIlevel
var(10) = ifelse(command = "z", 3, ifelse(command = "y", 2, 1))
[State 1000, Strength AI]
type = varset
trigger1 = !time && AIlevel
var(10) = ifelse((p2movetype = H || random < 500), 3, ifelse(random < 500, 2, 1))

[State 1000, width]
type = width
trigger1 = animelemtime(5) = 0
value = 30, 0

[State 1000, Hadouken]
type = helper
trigger1 = animelemtime(3) = 3
helpertype = normal
stateno = 1005
ID = 1005
name = "Hadouken"
postype = p1
pos = 70, -73
size.xscale = 0.45
size.yscale = 0.45
ownpal = 1

[State 1000, Snd]
type = playsnd
trigger1 = animelem = 1
value = 4, 1000
channel = 0
[State 1000, Snd]
type = playsnd
trigger1 = animelemtime(3) = 3
value = 5, 1000

[State 1000, CC]
type = changestate
triggerall = var(20)
trigger1 = var(18) && animelemtime(3) >= 0
trigger1 = command = "236p" 
value = 1000

[State 1000, End]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1


