triggerall = var(39) = 0
triggerall = prevstateno != 5130
trigger1 = !alive && var(41) = 1
trigger1 = var(41) := 2
value = 12,0
ignorehitpause = 1

[State -2, KO Sound]
type = PlaySnd
triggerall = var(39) = 1
triggerall = prevstateno != 5130
trigger1 = !alive && var(41) = 1
trigger1 = var(41) := 2
value = 12,10
ignorehitpause = 1

[State -2, KO Sound]
