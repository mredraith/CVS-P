;--------------------------------------------------------------------------
; KO Sound
[State -2, KO Sound Variable]
type = VarSet
triggerall = stateno != 5130
trigger1 = alive && var(41) > 0
trigger2 = !alive && var(41) < 2
var(41) = ifelse(alive, 0, var(41) + 1)
