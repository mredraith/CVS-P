;***************************************************************************;
;******************************* Common State ******************************;
;***************************************************************************;
;***************************************************************************;

;----------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 999,0]
type = destroyself
trigger1 = ishelper

[State 0, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno = 20 && Anim != 25
value = 25

[State 0, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim = 5300 && Anim != 5301
value = 5301

[State 210, 1]
type = PlaySnd
trigger1 = Anim = 5301
trigger1 = animelem = 14
value = 5300,1

[State 210, 1]
type = PlaySnd
triggerall = anim = 1005
trigger1 = animelem = 7
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 800 || anim = 830
trigger1 = animelem = 9
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 5301
trigger1 = animelem = 15
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 730
trigger1 = animelem = 17
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 3170
trigger1 = animelem = 10
value = 20,0

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 1005
trigger1 = animelem = 7
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 800 || anim = 830
trigger1 = animelem = 9
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 5301
trigger1 = animelem = 15
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 730
trigger1 = animelem = 17
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 3170
trigger1 = animelem = 10
value = s20,1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 2 && Anim != 3 && Anim != 4
trigger1 = Anim != [25,100]
trigger1 = Anim != [200,3500]
trigger1 = Anim != [5300,5301]
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
trigger3 = Anim = [25,3500]
trigger3 = Animtime = 0
trigger4 = Anim = 5301
trigger4 = Animtime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 2]
type = Changeanim
trigger1 = random <= 200
trigger1 = Anim = 0 && Animelem = 15
value = 2

[State 0, 2]
type = Changeanim
trigger1 = Anim = 0 && Animtime = 0
value = 4

[State 0, 2]
type = Changeanim
trigger1 = random <= 500
trigger1 = Anim = 4 && Animelem = 16
value = 3

[State 0, 2]
type = Changeanim
trigger1 = Anim = 3 && Animtime = 0
value = 0
elem = 5

[State 0, 2]
type = Changeanim
trigger1 = Anim = 2 && Animtime = 0
value = 0
elem = 2

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch
[Statedef 11]
type = C
physics = C
anim = 11
velset = 0,0
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type = S
physics = S
anim = 12

[State 210, 1]
type = PlaySnd
trigger1 = animelem = 4
value = 20,0

[State 19, Gi Flop]
type = PlaySnd
trigger1 = animelem = 4
value = s20,1

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, dust]
type = helper
trigger1 = !animtime
helpertype = normal
stateno = 7100
ID = 7100
name = "Dust"
postype = p1
ownpal = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 0, VarSet]
type = VarSet
trigger1 = time =0
v = 13
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = command = "superjump"
v = 13
value = 3

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = (PrevStateNo = 100 || PrevStateNo = 110) && sysvar(1) = 1
trigger2 = Command = "superjump"
trigger3 = Command = "superjump" && Command = "holdfwd"
trigger4 = Command = "superjump" && Command = "holdback"
var(13) = 3

[State 0, VarSet]
type = VarSet
trigger1 = var(13)!=3
trigger1 = command != "holdup"
v = 13
value = 1;.75;(.75*1.15)

[State 0, VarSet]
type = VarSet
trigger1 = var(13)!=3
trigger1 = command = "holdup"
v = 13
value = 2

[State 0, VarSet]
type = VarSet
trigger1 = var(13)!=3
trigger1 = command = "holdup"
trigger1 = prevstateno = 100
v = 13
value = 4

[State 40, 4]
type = VelSet
trigger1 = var(13) = 1
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = (const(velocity.jump.y))*.75

[State 40, 4]
type = VelSet
trigger1 = (var(13) = 2) || (var(13) = 4)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = (const(velocity.jump.y))

[State 40, 4]
type = VelSet
trigger1 = var(13) = 3
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = (const(velocity.jump.y))*1.15

[State 40, 5]
type = VelSet
trigger1 = var(13) = 1
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = (const(velocity.jump.y))*.75

[State 40, 5]
type = VelSet
trigger1 = (var(13) = 2) || (var(13) = 4)
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = (const(velocity.jump.y))

[State 40, 5]
type = VelSet
trigger1 = var(13) = 3
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = (const(velocity.jump.y))*1.15

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimTime = 0
trigger1 = (var(13) !=3) && (var(13) !=4)
value = S21,1
volume = 0
channel = -1

[State 0, PlaySnd]
type = PlaySnd
triggerall = AnimTime = 0
trigger1 = (var(13) =3) || (var(13) =4)
value = S21,2
volume = 0
channel = -1

[State 40, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = VelSet
trigger1 = 1
x = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = 1
y = 0

[State 52, No Walk]
type = AssertSpecial
trigger1 = 1
flag = nowalk

[State 5950, Dust]
type = explod
triggerall = prevstateno = 51
trigger1 = time = 0
anim = 7401
sprpriority = -3
postype = p1
pos = 0,0
scale = .6,.6
pausemovetime = -1
supermovetime = -1
ownpal = 1

[State 1000, Dust]
type = helper
triggerall = prevstateno != 51
trigger1 = time = 0
helpertype = normal
stateno = 7200
ID = 7200
name = "Dust"
postype = p1
ownpal = 1
size.xscale = .5
size.yscale = .5

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 21,3
volume = 255

[State 52, Turn]
type = ChangeAnim
trigger1 = ctrl && p2dist x<0
trigger1 = anim!=5
value = 5

[State 52, Turn]
type = turn
trigger1 = anim = 5 && animelem=1

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = Time = 3
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Dash Forward
[Statedef 100]
type = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, Dust]
type = helper
trigger1 = animelem = 1
helpertype = normal
stateno = 7416
ID = 7416
pos = -20,0
name = "Dash Dust"
postype = p1
pausemovetime = 255
supermovetime = 255
ownpal = 1

[State 19, Gi Flop]
type = PlaySnd
trigger1 = animelem = 1
value = s100,7

[State 100, Voice]
type = PlaySnd
triggerall = var(39) = 0
triggerall = random < 300
trigger1 = animelem = 1
value = s110,0

[State 100, Voice]
type = PlaySnd
triggerall = var(39) = 1
triggerall = random < 300
trigger1 = animelem = 1
value = s120,0

[State 100, 1]
type = VelSet
trigger1 = animelem = 2
x = 20

[State 100, 1]
type = VelSet
trigger1 = animelem = 3
x = 0

[State 100, 2]
type = Playsnd
trigger1 = time = 0
value = 100,3
volume = 255

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 4]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 1]
type = ctrlset
trigger1 = time = 11
value = 1

[State 100, 5]
type = ChangeState
trigger1 = time >= 9
value = ifelse(command != "holdfwd", 0, 110)
ctrl = 1

;---------------------------------------------------------------------------
; Run Forward
[Statedef 110]
type = S
physics = S
anim = 110
sprpriority = 1
ctrl = 0

[State 110, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 110, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, Jump]
type = ChangeState
trigger1 = (Command="holdfwd" && Command="holdup")
value = 40

[State 110, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 110, SND]
type = PlaySnd
trigger1 = animelem = 2
value = 100,0
volume = 255

[State 110, SND]
type = PlaySnd
trigger1 = animelem = 5
value = 100,1
volume = 255

[State 110, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 111

;---------------------------------------------------------------------------
; Dash/Run Forward End
[Statedef 111]
type = S
physics = S
anim = 101
sprpriority = 1
ctrl = 0

[State 111,Stop Dust]
type = Explod
trigger1 = time=0 || time=3 || time=6
anim = 7415
pos = 15,0
postype = P1
scale = .3,.3
velocity = 2,-0.5
sprpriority = 5
ownpal = 1
supermovetime = 999

[State 111, 2]
type = Playsnd
trigger1 = time = 0
value = 100,2
volume = 255

[State 111, 1]
type = CtrlSet
trigger1 = time > 0
value = 1

[State 111, 2]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

