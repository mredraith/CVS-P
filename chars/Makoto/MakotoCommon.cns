[State 100, Voice]
type = PlaySnd
triggerall = var(39) = 1
triggerall = random < 300
trigger1 = animelem = 1
value = s120,0

[State 105, AssertSpecial]
type = AssertSpecial
trigger1 = AnimElem = 1
flag = NoWalk

[State 100, 2]
type = Playsnd
