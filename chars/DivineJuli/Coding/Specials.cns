[Statedef 1100]
type = A
movetype = A
physics = N
anim = 1100
ctrl = 0
velset = 0,0
poweradd = 70 * !var(20)
sprpriority = 2
;facep2 = 1

[State 1100, Button Detect]
type = VarSet
trigger1 = !Time
var(10) = ifElse((command = "a" || command = "rlsa"), 0, ifElse((command = "b" || command = "rlsb"), 1, 2))

[State 1100, Voice]
type = PlaySnd
trigger1 = AnimElem = 3
value = 0,2
channel = 0

[State 1100, Swing Snd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 1, 5
channel = 1

[State 1100, Friction]
type = VelAdd
trigger1 = AnimElemTime(4) >= 0 && Vel x > 0
x = -0.012

[State 1100, Start Up Vel]
type = VelSet
trigger1 = Vel x < 0
x = 0

[State 1100, Gravity]
type = VelAdd
trigger1 = AnimElemTime(4) >= 0
y = .66

[State 1100, Velocity]
type = VelSet
trigger1 = AnimElem = 4
x = ifElse(var(10)=2, 6.65, ifElse(var(10)=1, 5.5, 4.5))
y = 4

