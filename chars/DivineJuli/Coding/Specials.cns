guardsound = S130,0
pausetime = 7, 7
guard.pausetime = 12,12
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 36), var(36) := 6
air.animtype = Back
fall.animtype = Back
ground.type = High
air.type = Low
ground.slidetime = 12
ground.hittime  = 12
guard.hittime = (12) - 6
down.hittime = 18
ground.velocity = -5.5, 0
air.velocity = -4.25, -7.25
guard.velocity = -5.5
airguard.velocity = -8, -1
down.velocity = 0, 0
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
down.cornerpush.veloff = 0
yaccel = .58
fall = 0
air.fall = 1
fall.recover = 1
fall.recovertime = 120
forcestand = 1
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 14
envshake.ampl = 4
envShake.freq = 120

[State 1100, End]
