trigger1 = 1
y = 0

[State 1005, Land Snd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 52,0

[State 1005, Land Dust]
type = Explod
trigger1 = AnimElem = 2
anim = 8102
sprpriority = -3
postype = p1
scale = .5,.5
pausemovetime = -1
supermovetime = -1
ownpal = 1

[State 1005, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

