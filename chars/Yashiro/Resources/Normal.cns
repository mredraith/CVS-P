trigger1 = animelem = 3
value=1,2
channel=1

[State 222, Pos]
type = posadd
trigger1 = animelem = 4 || animelem = 9
x = 16

[State 222, Hit]
type = hitdef
trigger1 = !var(16) && (var(15) < 1 || var(20))
trigger1 = animelem = 5
attr = S, NA
hitflag = MAF
guardflag = M
priority = 4, Hit
damage = Ifelse(var(55),65,88), 0
getpower=30 * !var(20), 0
givepower=30, 30
