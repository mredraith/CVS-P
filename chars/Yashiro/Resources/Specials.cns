triggerall = (var(15)<5 || var(20))
trigger1 = !time
attr = S, SA
animtype = hard
damage = 20+2*var(10), 10
priority = 7, Hit
getpower=Ifelse((var(10)=3), 0,36 * !var(20)), 0
guardflag = M
