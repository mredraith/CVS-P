guard.sparkNo=-1 + 0 * (var(34) :=8001)
sparkXY=-10 + 0 * (var(35) :=100), var(36) :=-88
hitsound=S2+10*var(44),2
guardsound=s130, 0
ground.type = high
ground.slidetime = 20
ground.hittime = 20
guard.hittime = (20) - 6
ground.velocity = -5.5
air.velocity = -5.5,-3.5
air.fall = 1
fall.recover = 0
ground.cornerPush.velOff = 0
palfx.time = 12*var(9)
palfx.add = 255,255,255
palfx.sinadd= -255,-255,-255,48

[state a]
type = changestate
trigger1 = var(2) = 1 || var(2) = 2
value = Ifelse(var(2) = 1,1020,1021)

[state a]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

