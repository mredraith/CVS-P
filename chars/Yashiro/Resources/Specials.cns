;---------------------------------------------------------------------------
;Jet Counter
[Statedef 1000]
type = S
movetype= A
physics = N
poweradd=72 * !var(20)
velset = 0,0
sprpriority = 1
ctrl = 0

[State 1000, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))

[State 1000, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || Random < 500), 2, ifElse(Random < 500, 1, 0))

[State 903, Anim]
type = ChangeAnim
trigger1 = !Time
value = 1000

[state a]
type = varset
trigger1 = !time
v = 2
value = 0

[state a]
type = varset
triggerall = movecontact
trigger1 = command = "holdfwd" && command = "x" || command = "holdfwd" && command = "y" || command = "holdfwd" && command = "z"
v = 2
value = 1
ignorehitpause = 1

[state a]
type = varset
triggerall = movecontact
trigger1 = command = "holddown" && command = "x" || command = "holddown" && command = "y" || command = "holddown" && command = "z"
v = 2
value = 2
ignorehitpause = 1

[state a]
type = varset
triggerall = movecontact
trigger1 = command = "holdfwd" && command = "a" || command = "holdfwd" && command = "b" || command = "holdfwd" && command = "c"
v = 2
value = 3
ignorehitpause = 1

[State a]
type = PlaySnd
trigger1 = animelem = 1
value=1000,var(40)
channel = 0
[State a]
type = PlaySnd
trigger1 = animelem = 3
value = 101,0
channel=1

[State 102, Dust]
type = helper
trigger1=AnimElem=3
stateno = 8103
ID = 8100
name = "Dash Dust"
pos = -20,10
postype = p1
pausemovetime = 255
supermovetime = 255
ownpal = 1

[state a]
type = nothitby
trigger1 = animelem = 6,>=0
trigger1 = animelem = 7,<0
value = SCA

[State 710, Start Roll]
type = VelSet
trigger1 = animelem = 3
x = 5 + (var(10) * 3)

[State 710, End Roll]
type = VelSet
trigger1 = animelem = 10
x = 0

[State 210, 2]
type = HitDef
trigger1 = animelem = 10
attr = S, SA
animtype = hard
damage = 68 + (var(10) * 4),6
priority = 7, Hit
getpower=36* !var(20), 0
guardflag = M
pauseTime=ifElse(var(20), 4, 12), ifElse(var(20), 6, 12)
guard.pauseTime=ifElse(var(20), 6, 12), ifElse(var(20), 6, 12)
sparkNo=-1 + 0 * (var(33) :=8013)
guard.sparkNo=-1 + 0 * (var(34) :=8001)
sparkXY=-10 + 0 * (var(35) := 120), var(36) := -81
hitsound=S2+10*var(44),2
guardsound=s130, 0
guard.sparkno = s7012
ground.type = high
ground.slidetime = 22
ground.hittime = 22
guard.hittime = (22) - 6
ground.velocity = -2.5
air.velocity = -2.5,-4.5
air.fall = 1
fall.recover = 0
ground.cornerPush.velOff = 0
palfx.time = 12*var(9)
palfx.add = 255,255,255
palfx.sinadd= -255,-255,-255,48

[state a]
type = changestate
trigger1 = var(2) = 1
value = 1010

[state a]
type = changestate
trigger1 = var(2) = 2
value = 1020

[state a]
type = changestate
trigger1 = var(2) = 3
value = 1030

[state a]
type = changestate
triggerall = AILEVEL
trigger1 = movecontact
value = 1030

[state a]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

