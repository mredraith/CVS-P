victory60 = "This isn't just a fight; it's a battle for our very existence against the demonic."
victory61 = "Back to the abyss with you, creature!"
victory62 = "This power of potential... it's a dangerous weapon."
victory63 = "We decide our reality, not some detached corporation."
victory64 = "Rose's wisdom guided us through the darkest times. Her strength was immense."
victory65 = "The echoes of their actions will resonate for eternity."
victory66 = "Harmony will be restored, one step, one victory at a time."
victory67 = "Those grey suits won't be missed."
victory68 = "The Final Judge was a monument to failed logic."
victory69 = "Maxima's final act saved countless lives. A true hero."
victory70 = "The Echo Forge unleashed more than Bison bargained for."
victory71 = "Humanity's 'flaws' are its greatest strengths, something CE never understood."
victory72 = "CE thought they could play god. They were wrong."
victory73 = "Find your song, and let it drown out the noise of chaos."
victory74 = "These Echoes... they show us what we could be, for better or worse."
victory75 = "Makai's taint will not spread further!"
victory76 = "The hunger of Makai is terrifying. We cannot let it win."
victory77 = "The price for their 'perfection' was too high."
victory78 = "The battle against oneself is often the hardest."
victory79 = "My Echo was strong, but my will is stronger."
victory80 = "Some Echoes are warnings, others are inspirations."
victory81 = "Fractured realities, fractured selves. A messy business."
victory82 = "The barriers between worlds are fragile. We must guard them."
victory83 = "Healing is also a form of fighting."
victory84 = "Feel the rhythm of the earth? It's a powerful ally."
victory85 = "Some souls shine so brightly they illuminate all realities."
victory86 = "The Demon Lords have fallen. Earth is safe from that particular nightmare."
victory87 = "Red Echo, Blue Echo... true strength lies in balancing them."
victory88 = "Let your spirit dance, even in the face of darkness."
victory89 = "My heart beats in time with a world that refuses to die."
victory90 = "My path is my own, not some faded copy."
victory91 = "The beat of life is strong. It will overcome the discord."
victory92 = "Jedah's ambition threatened all realms. It had to be stopped."
victory93 = "Convergence Enterprises... your sterile order is an affront to life."
victory94 = "Demons and Echoes... this world has seen too much."
victory95 = "Did you think your reflection held more power than the original?"
victory96 = "Their grand design crumbled under the weight of real spirit."
victory97 = "A universe without chaos is a universe without growth."
victory98 = "My power is more than a match for your fiendish tricks."
victory99 = "The world is healing, slowly but surely. We must protect that peace."

; ---------------------------------------------------------------------------
; Universal Feint System v3 (Added by Patcher)
; Cancels any move on its first contact frame if HP has been held for 10+ frames.
; This system uses Var(59) to track the hold duration.
[StateDef -2]

; State -2: Increment Hold Timer
; -- If HP ('z') is held, count up.
[State -2, Feint Hold Timer Increment]
type = VarSet
v = 59
triggerall = alive
trigger1 = command = "z"
value = Var(59) + 1
ignorehitpause = 1

; State -2: Reset Hold Timer
; -- If HP ('z') is NOT held, reset the counter to 0.
[State -2, Feint Hold Timer Reset]
type = VarSet
v = 59
triggerall = alive
trigger1 = command != "z"
value = 0
ignorehitpause = 1

; State -2: Feint Cancel Activation
; -- Change state back to idle if the feint conditions are met.
[State -2, Feint Cancel Activation]
type = ChangeState
value = 0
triggerall = alive && ctrl
trigger1 = MoveContact = 1
trigger2 = Var(59) > 10
trigger3 = Power >= 100

; State -2: Feint Cancel Power Cost
; -- Subtract the power cost. Triggers must match activation exactly.
[State -2, Feint Cancel Power Cost]
type = PowerAdd
value = -100
triggerall = alive && ctrl
trigger1 = MoveContact = 1
trigger2 = Var(59) > 10
trigger3 = Power >= 100
; --- End Universal Feint System ---
