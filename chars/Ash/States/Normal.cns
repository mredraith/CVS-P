[State 240, HitDef]
type=HitDef
trigger1 = !var(16) && (var(15)<1 || var(20))
trigger1=!Time
attr=S,NA 
hitflag=MAF 
guardflag=H 
animtype=hard 
priority=4,Hit 
damage = ceil(ifElse(fvar(11) * 63 < 7, 7, fvar(11) * 63)), 0
ID = 200*!var(20)
getpower=30 * !var(20) * !var(57), 0
givepower=30, 30
pausetime = Ifelse(var(20), 6, 12), Ifelse(var(20), 6, 12)
guard.pausetime = Ifelse(var(20), 6, 12), Ifelse(var(20), 6, 12)
sparkNo=-1 + 0 * (var(33) := 8012)
guard.sparkNo=-1 + 0 * (var(34) := 8000)
sparkXY=-10 + 0 * (var(35) := 80), var(36) := -55
hitsound=-1 + 0*(var(31):=1)
guardsound=-1 + 0 * (var(32) := 0)
air.animType=Back
fall.animType=Back
ground.type=High 
air.type=Low
ground.slidetime=18 + 4*var(9)
ground.hittime=22 + 4*var(9)
guard.hittime = (22 + 4*var(9)) - 6
air.hittime=120
ground.velocity=ceil(-10.52)*(ifelse(!var(20),1,.5))
guard.velocity=ceil(-10.52)*(ifelse(!var(20),1,.5))
air.velocity=-5.39, -5.65
ground.cornerPush.velOff=0
guard.cornerPush.velOff=0
air.cornerPush.velOff=0
yAccel = (0.5 + (ComboCount * 0.04))
fall=0
fall.recover=1
fall.recovertime=120
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd= -255,-255,-255,48

