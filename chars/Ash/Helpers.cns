;Ventose
[Statedef 1005]
type=A
physics=N
movetype=A
ctrl=0
velset=0, 0
sprpriority=5

[State 1005, HitOverride]
type=hitoverride
trigger1=1
time=-1
attr=SCA, AA, AP, AT
stateno=Ifelse(var(10)=3&&var(8)<2,1005,1006)
ignorehitpause=1

[State 1005, HB]
type=hitby
trigger1=1
time=-1
value=SCA, NP, SP, HP
ignorehitpause=1

[State 1005, movehitvar]
type=varset
trigger1=movecontact && numtarget
trigger1=!(target, ishelper)
var(3)=1
ignorehitpause=1

[State 1005, VarAdd]
type=VarAdd
trigger1 =!time
var(8)=1

[State 1005, Strength]
type=varset
trigger1=!time&&!prevstateno
var(10)=root, var(10)

[State 1005, Strength]
type=varset
trigger1=!time&&!prevstateno
var(12)=root, var(12)

[State 1005, ChangeAnim]
type=ChangeAnim
trigger1 =!time&&!prevstateno
value=Ifelse(Var(10)=1,1060,1010)

[State 1005, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 1005, Assert]
type=trans
trigger1=1
trans=addalpha
alpha=256, 256
ignorehitpause=1

[State 1005, VelSet]
type = VelSet
trigger1 =  1
x = 4 + (var(10) * 1.125)
 
[State 1005, Vel]
type=velset
trigger1=!time && var(12)
x=Ifelse(var(10)=3,6,5)

[State 1005, HitSound]
type=playsnd
trigger1=movehit && numtarget
trigger1=target, time=0 && target, movetype=H
value=2, 6
persistent=0
ignorehitpause=1

[State 1005, High]
type=hitdef
trigger1 = !var(16) && (var(15)<1 || var(20))
trigger1=!var(12) && Var(10)!=2
priority=4, Hit
attr=A, SP
damage=floor(Ifelse(root,var(20),60,Ifelse(var(10)=3,40,Ifelse(var(10)=3,40,76+6*var(10))))*root,fvar(10)),10
animtype=Hard
hitflag=MAF
guardflag=MA
pausetime=3*(var(10)=3),12/((root,var(20)>0)+1)
sparkNo=-1
guard.sparkNo=-1
sparkXY=-1
guardsound=s130,1
ground.type=High
ground.slidetime=6
ground.hittime=12
guard.hittime = (12) - 6
ground.velocity=Ifelse(root,var(20),-5,-10),Ifelse(var(10)=3,-4,0)
ground.cornerpush.veloff=Ifelse(root,var(20),0,-5)
air.velocity=Ifelse(root,var(20),-2,-4), -4
down.velocity=0,0
air.fall=1
fall=var(10)=3
fall.recover=0
getpower=Ifelse(var(10)=3,0,ifelse(p2movetype=H,72,144)*!(root,var(20))),Ifelse(var(10)=3,0,36*!(root,var(20)))
givepower=36, 36
envshake.time=12
envshake.ampl=5
sprpriority=5
yaccel=.5
airguard.ctrltime=12
airguard.velocity=ifelse((root,var(20)),-4,-8),-3
forcestand=1
palFX.time = 30
palFX.mul = 128, 128, 128
palFX.sinAdd = 96, 96, 96, 4

