;------------------------------------------------------------------
;Ventose
[Statedef 1000]
type=S
movetype=A
physics=N
ctrl=0
velset=0,0
poweradd=72 * !var(20)
sprpriority=1
facep2=1

;Este es el Button Dettect Var (Var(10), esta parte es de suma importancia ya que va a poner el Var para que luego
;sea usado, el "Ifelse" es fundamental, el mismo es como una forma ms simple de variante,
;Pones un valor, en este caso el comando y luego de una coma el valor asignado, 
;Aqui con el comando "Ventose1" que es el boton X, y "Ventose4" que es el mismo pero cambiado con el config
;Al presionar ese comando vas a poner la variante con el nmero 0, que es igual a la version debil del movimiento
;Luego lo mismo con el boton Y ("Ventose2" y "Ventose5") que pondran "1", igual=medio
;El "2" de ultimo representa que en la ausencia de los primeros dos comandos, se pondra el "2" (Fuerte)

[State 1000, VarSet]
type=VarSet
trigger1 =!AILevel && !time
var(10)=Ifelse(command="Ventose1"||command="Ventose4",0,Ifelse(command="Ventose2"||command="Ventose5",1,2))
ignorehitpause=1

[State 1100, VarSet]
type=VarSet
trigger1 =AILevel&& !time
var(10)=ifelse(random<700,1,2)
ignorehitpause=1

;Este ChangeAnim es el que pondr la animacin correspondiente a cada boton
;El "+var(10)" indica que usar por default la anim 1000, pero al estar el Var(10) en 1 o 2
;Se sumar ese mismo nmero al de la anim
;Por eso la animaciones DEBEN tener estos nmeros:
;1000(Debil), 1001(Medio), 1002(Fuerte)

[State 1100, Anim]
type = ChangeAnim
trigger1 = !time
value = 1000+var(10)+var(28)*10000
ignorehitpause=1

[State 1000, width]
type=width
trigger1= animelemtime(6)=-1
value=30,0

[State 1000, Voice]
type=PlaySnd
trigger1 =animelem = 5 && Var(10)=0 
value= s0,8
channel=0
[State 1000, Voice]
type=PlaySnd
trigger1 =animelem = 7 && Var(10)=1
value= s0,8
channel=0
[State 1000, Voice]
type=PlaySnd
trigger1 =animelem = 5 && Var(10)=2
value= s0,9
channel=0

[State 1000, Move Snd]
type=PlaySnd
trigger1=animelem = 7 && Var(10)=0
value=s0,10
[State 1000, Move Snd]
type=PlaySnd
trigger1=animelem = 7 && Var(10)=1
value=s0,10
[State 1000, Move Snd]
type=PlaySnd
trigger1=animelem = 5 && Var(10)=2
value=s0,10
[State 1000, Move Snd]
type=PlaySnd
trigger1=animelem = 11 && Var(10)=2
value=s0,11
[State 220, Swing Snd]
type=playsnd
trigger1=animelem = 7 && Var(10)=0
value=1,5
channel=4
[State 220, Swing Snd]
type=playsnd
trigger1=animelem = 7 && Var(10)=1
value=1,5
channel=4
[State 220, Swing Snd]
type=playsnd
trigger1=animelem = 5 && Var(10)=2
value=1,5
channel=4
[State 220, Swing Snd]
type=playsnd
trigger1=animelem = 11 && Var(10)=2
value=1,5
channel=4


;En este explod puse el Var(10) en el trigger
;El "!" antes del nmero indica "cuando no", es decir, cuando este nmero no esta activado
;De esta forma, el explod aparecera cuando la Var NO este en "1"

[State 1000, Hand Explod]
type = Explod
trigger1 = Var(10)!=1 && animelem = 5
anim = 1005
ID = 1005
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = .5,.5
sprpriority = 5
ontop = 1
ownpal = 1

;En este le quit el "!" para indicar que el explod saldr cuando la Var sea "1"
;Al igual que en el siguiente
;De este modo, este explod solo saldr en la versin media del movimiento, al igual que el siguiente saldr
;En la fuerte

[State 1000, Hand Explod]
type = Explod
trigger1 = Var(10)=1 && animelem = 8
anim = 1055
ID = 1055
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = .5,.5
sprpriority = 5
ontop = 1
ownpal = 1

;Te preguntaras por que no le puse un "!" al anterior, por que quiero que ese Explod aparezca tanto en la versin media 
;Como la fuerte

[State 1000, Hand Explod]
type = Explod
trigger1 = Var(10)=2 && animelem = 12
anim = 1055
ID = 1055
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
scale = .5,.5
sprpriority = 5
ontop = 1
ownpal = 1

[State 1000, Helper]
type=Helper
trigger1 = Var(10)=0 && animelem=7 
helpertype=normal ;player
name ="Ventose"
ID =1005
stateno = 1005
persistent=1
pos=50,-80
postype=p1
ownpal=1
size.xscale=.5*const(size.xscale)
size.yscale=.5*const(size.yscale)

[State 1000, Helper]
type=Helper
trigger1 = Var(10)=1 && animelem=7
helpertype=normal ;player
name ="Ventose"
ID =1005
stateno = 1005
persistent=1
pos=50,-80
postype=p1
ownpal=1
size.xscale=.5*const(size.xscale)
size.yscale=.5*const(size.yscale)

[State 1000, Helper]
type=Helper
trigger1 = Var(10)=2 && animelem=11 
helpertype=normal ;player
name ="Ventose"
ID =1005
stateno = 1005
persistent=1
pos=50,-80
postype=p1
ownpal=1
size.xscale=.5*const(size.xscale)
size.yscale=.5*const(size.yscale)

[State 1000, Helper]
type=Helper
trigger1 = Var(10)=2 && animelem=11
helpertype=normal ;player
name ="Ventose"
ID =1007
stateno = 1007
persistent=1
pos=50,-80
postype=p1
ownpal=1
size.xscale=.6*const(size.xscale)
size.yscale=.6*const(size.yscale)

[State 1000, StateTypeSet: Idle]
type=StateTypeSet
trigger1=AnimElemTime(7) =0
movetype=I 

[State 1000, Xe[gύX]
type = ChangeState
trigger1 = !animtime
value = 0
ctrl = 1

;Las Vars (especialmente) pueden ahorrarte mucho trabajo como hacer un State para cada version del
;movimiento, espero hayas entendido, cualquier duda me avisas

