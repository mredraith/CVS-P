x = IfElse(var(10)=0,2,IfElse(var(10)=1,4,4.5))

[State 1100, ]
type = Velset
trigger1 = AnimElemtime(11) >= 0
x = IfElse(var(10)=0,1.5,IfElse(var(10)=1,1.8,2))

[State 1100, ]
type = Velset
trigger1 = AnimElem = 4
y = IfElse(var(10)=0,-7,IfElse(var(10)=1,-7,-8))

[State 1100, ]
type = Veladd
trigger1 = AnimElemtime(4) >= 0
